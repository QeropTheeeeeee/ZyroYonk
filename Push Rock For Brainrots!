-- ===== Auto Collect Toggle (unchanged) =====
local autoCollectEnabled = false
local autoCollectThread = nil

local function runAutoCollect()
    while autoCollectEnabled do
        local char = player.Character
        if not char then task.wait(1) continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(1) continue end

        local spawnLocation = workspace:FindFirstChild("SpawnLocation")
        local zonesFolder = workspace:FindFirstChild("Zones")
        if not zonesFolder then task.wait(2) continue end

        local zoneFolder = zonesFolder:FindFirstChild(selectedZone)
        if not zoneFolder then task.wait(2) continue end

        local targetPart = nil
        local targetModel = nil
        for _, target in ipairs(zoneFolder:GetChildren()) do
            if target:IsA("BasePart") then
                targetPart = target
                targetModel = target
            elseif target:IsA("Model") then
                targetPart = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart")
                targetModel = target
            end
            if targetPart then break end
        end

        if not targetPart then task.wait(2) continue end

        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.5)

        local prompt = targetModel:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            fireproximityprompt(prompt)
            task.wait(0.3)
        end

        if spawnLocation then
            hrp.CFrame = spawnLocation.CFrame + Vector3.new(0, 3, 0)
        end
        task.wait(0.5)
    end
end

