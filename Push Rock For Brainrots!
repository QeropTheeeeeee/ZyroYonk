-- ================== ROBUST LIVE PING (MULTIPLE METHODS) ==================
local function getPing()
    local success, stat = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if success and type(stat) == "number" and stat > 0 then
        return math.floor(stat)
    end
    success, stat = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Ping"]:GetValue()
    end)
    if success and type(stat) == "number" and stat > 0 then
        return math.floor(stat)
    end
    success, stat = pcall(function()
        return game:GetService("Stats").Network.Ping:GetValue()
    end)
    if success and type(stat) == "number" and stat > 0 then
        return math.floor(stat)
    end
    local sent = tick()
    local dummy = Instance.new("Part")
    dummy.Parent = workspace
    local received = tick()
    dummy:Destroy()
    local estimate = math.floor((received - sent) * 500)
    if estimate > 0 then return estimate end
    return 0
end

