-- Helper to create toggles with loops
local function createAutoToggle(title, desc, interval, fireFunction)
    local enabled = false
    local thread = nil
    MainTab:Toggle({
        Title = title,
        Desc = desc,
        Default = false,
        Callback = function(state)
            enabled = state
            if state then
                thread = task.spawn(function()
                    while enabled do
                        fireFunction()
                        task.wait(interval)
                    end
                end)
                WindUI:Notify({ Title = title .. " ON", Content = "Every " .. interval .. "s", Duration = 2, Icon = "play" })
            else
                enabled = false
                if thread then task.cancel(thread); thread = nil end
                WindUI:Notify({ Title = title .. " OFF", Content = "Stopped.", Duration = 2, Icon = "square" })
            end
        end
    })
end

