-- Function to update paragraph content
local function updateZoneInfoParagraph()
    local zonesFolder = workspace:FindFirstChild("Zones")
    if not zonesFolder then
        zoneInfoParagraph:SetTitle("Zone Info — " .. selectedZoneTitle)
        zoneInfoParagraph:SetDesc("Zones folder not found!")
        return
    end

    local zoneFolder = zonesFolder:FindFirstChild(selectedZone)
    if not zoneFolder then
        zoneInfoParagraph:SetTitle("Zone Info — " .. selectedZoneTitle)
        zoneInfoParagraph:SetDesc("Zone '" .. selectedZone .. "' does not exist.")
        return
    end

    local children = zoneFolder:GetChildren()
    if #children == 0 then
        zoneInfoParagraph:SetTitle("Zone Info — " .. selectedZoneTitle)
        zoneInfoParagraph:SetDesc("(empty)")
        return
    end

    local names = {}
    for _, obj in ipairs(children) do
        table.insert(names, "• " .. obj.Name)
    end
    zoneInfoParagraph:SetTitle("Zone Info — " .. selectedZoneTitle)
    zoneInfoParagraph:SetDesc(table.concat(names, "\n"))
end

