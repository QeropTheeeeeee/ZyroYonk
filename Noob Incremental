    local runeZone = workspace.__GAME_CONTENT.RuneZones.Basic._Zone_Rune_Roll

    local function touchRuneZone()
        if not runeZone or not runeZone:IsA("BasePart") then
            warn("Rune zone not found!")
            return false
        end
        local char = player.Character
        if not char then return false end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        if not rootPart then return false end
        local originalCFrame = rootPart.CFrame
        local touchPos = runeZone.CFrame + Vector3.new(0, 2, 0)
        rootPart.CFrame = touchPos
        task.wait(0.1)
        rootPart.CFrame = originalCFrame
        return true
    end

    local function autoRollRunesLoop()
        while autoRollRunesEnabled do
            touchRuneZone()
            task.wait(1) -- Wait 1 second between rolls
        end
    end

    MainTab:Toggle({
        Title = "Auto Roll Runes",
        Default = false,
        Callback = function(state)
            autoRollRunesEnabled = state
            if state then
                if autoRollRunesThread then task.cancel(autoRollRunesThread) end
                autoRollRunesThread = task.spawn(autoRollRunesLoop)
                WindUI:Notify({ Title = "Auto Roll Runes ON", Duration = 2, Icon = "dice" })
            else
                if autoRollRunesThread then task.cancel(autoRollRunesThread); autoRollRunesThread = nil end
                WindUI:Notify({ Title = "Auto Roll Runes OFF", Duration = 2, Icon = "square" })
            end
        end
    })

    -- ========== MISC TAB CONTENT ==========
    MiscTab:Section({ Title = "Fly" })
    local flySpeed = 50
    local flyEnabled = false
    local flyBodyVelocity, flyBodyGyro, flyLoopThread = nil, nil, nil
    local function startFly()
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        hum.PlatformStand = true
        flyBodyVelocity = Instance.new("BodyVelocity")
        flyBodyVelocity.Velocity = Vector3.new(0,0,0)
        flyBodyVelocity.MaxForce = Vector3.new(1e9,1e9,1e9)
        flyBodyVelocity.Parent = root
        flyBodyGyro = Instance.new("BodyGyro")
        flyBodyGyro.MaxTorque = Vector3.new(1e9,1e9,1e9)
        flyBodyGyro.D = 100
        flyBodyGyro.CFrame = root.CFrame
        flyBodyGyro.Parent = root
        flyLoopThread = task.spawn(function()
            while flyEnabled do
                local c = player.Character
                if not c then break end
                local r = c:FindFirstChild("HumanoidRootPart")
                if not r then break end
                local cam = workspace.CurrentCamera
                local dir = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
                if dir.Magnitude > 0 then flyBodyVelocity.Velocity = dir.Unit * flySpeed else flyBodyVelocity.Velocity = Vector3.new(0,0,0) end
                flyBodyGyro.CFrame = cam.CFrame
                task.wait()
            end
        end)
    end
    local function stopFly()
        if flyBodyVelocity then flyBodyVelocity:Destroy() end
        if flyBodyGyro then flyBodyGyro:Destroy() end
        if flyLoopThread then task.cancel(flyLoopThread) end
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end
    MiscTab:Input({
        Title = "Fly Speed",
        Placeholder = "Enter speed...",
        Numeric = true,
        Finished = true,
        Callback = function(v)
            local num = tonumber(v)
            if num and num > 0 then flySpeed = num; WindUI:Notify({ Title = "Fly Speed Set", Content = tostring(num), Duration = 2, Icon = "zap" }) end
        end
    })
    MiscTab:Toggle({
        Title = "Enable Fly",
        Default = false,
        Callback = function(state)
            flyEnabled = state
            if state then startFly() else stopFly() end
            WindUI:Notify({ Title = state and "Fly ON" or "Fly OFF", Duration = 2 })
        end
    })
    player.CharacterAdded:Connect(function()
        if flyEnabled then task.wait(1); startFly() end
    end)

    MiscTab:Section({ Title = "Movement Speed" })
    local moveSpeed = 16
    local moveSpeedEnabled = false
    local moveSpeedConn = nil
    MiscTab:Input({
        Title = "Movement Speed",
        Placeholder = "Enter speed...",
        Numeric = true,
        Finished = true,
        Callback = function(v)
            local num = tonumber(v)
            if num and num > 0 then
                moveSpeed = num
                if moveSpeedEnabled then
                    local char = player.Character
                    if char and char:FindFirstChild("Humanoid") then char.Humanoid.WalkSpeed = moveSpeed end
                end
                WindUI:Notify({ Title = "Move Speed Set", Content = tostring(num), Duration = 2, Icon = "zap" })
            end
        end
    })
    MiscTab:Toggle({
        Title = "Enable Move Speed",
        Default = false,
        Callback = function(state)
            moveSpeedEnabled = state
            local function applySpeed()
                local char = player.Character
                if char and char:FindFirstChild("Humanoid") then
                    char.Humanoid.WalkSpeed = state and moveSpeed or 16
                end
            end
            applySpeed()
            if state then
                moveSpeedConn = player.CharacterAdded:Connect(function(char)
                    task.wait(1)
                    if moveSpeedEnabled and char:FindFirstChild("Humanoid") then
                        char.Humanoid.WalkSpeed = moveSpeed
                    end
                end)
                WindUI:Notify({ Title = "Move Speed ON", Duration = 3, Icon = "activity" })
            else
                if moveSpeedConn then moveSpeedConn:Disconnect(); moveSpeedConn = nil end
                WindUI:Notify({ Title = "Move Speed OFF", Duration = 2, Icon = "minus-circle" })
            end
        end
    })

    -- ========== SUPPORT TAB CONTENT ==========
    local InviteCode = "D5NKtBJEzz"
    local DiscordAPI = "https://discord.com/api/v10/invites/" .. InviteCode .. "?with_counts=true&with_expiration=true"

    local function httpGet(url)
        if syn and syn.request then
            local res = syn.request({ Url = url, Method = "GET" })
            if res and res.Body then return res.Body end
        elseif request then
            local res = request({ Url = url, Method = "GET" })
            if res and res.Body then return res.Body end
        elseif http_request then
            local res = http_request({ Url = url, Method = "GET" })
            if res and res.Body then return res.Body end
        end
        return nil
    end

    local raw = httpGet(DiscordAPI)
    local Response = {}
    if raw then pcall(function() Response = HttpService:JSONDecode(raw) end) end
    local onlineCount = Response and Response.approximate_presence_count or "?"
    local totalCount = Response and Response.approximate_member_count or "?"
    local guildName = (Response and Response.guild and Response.guild.name) or "ZyroYonk Hub"
