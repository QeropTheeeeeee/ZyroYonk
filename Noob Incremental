    -- ================== AUTO CONVERT WITH CUSTOM THRESHOLD ==================
    local convertThreshold = 150000  -- default
    local autoConvertEnabled = false
    local autoConvertConnection = nil
    local autoConvertRemote = mainRemote
    local autoConvertTextObject = nil
    local autoConvertCanFire = true

    -- Input for threshold
    MainTab:Input({
        Title = "Convert Blaze",
        Placeholder = "Enter number (e.g., 500000)",
        Numeric = true,
        Finished = true,
        Callback = function(value)
            local num = tonumber(value)
            if num and num > 0 then
                convertThreshold = num
                WindUI:Notify({ Title = "Threshold Set", Content = tostring(convertThreshold), Duration = 2, Icon = "check-circle" })
            else
                WindUI:Notify({ Title = "Invalid Number", Content = "Using previous: " .. convertThreshold, Duration = 2, Icon = "alert-triangle" })
            end
        end
    })

    local function parseCurrencyTextForConvert(text)
        if type(text) ~= "string" then return 0 end
        local cleaned = text:gsub("[%s,]", "")
        if cleaned:upper():match("K$") then
            local num = tonumber(cleaned:sub(1, -2))
            return (num or 0) * 1000
        elseif cleaned:upper():match("M$") then
            local num = tonumber(cleaned:sub(1, -2))
            return (num or 0) * 1000000
        else
            return tonumber(cleaned) or 0
        end
    end

    local function checkAndFireConvert()
        if not autoConvertEnabled then return end
        if not autoConvertCanFire then return end
        if not autoConvertTextObject then return end
        local value = parseCurrencyTextForConvert(autoConvertTextObject.Text)
        if value >= convertThreshold then
            autoConvertCanFire = false
            autoConvertRemote:FireServer("Blaze")
            task.wait(1)
            autoConvertCanFire = true
        end
    end

    local function startAutoConvert()
        pcall(function()
            local localPlayer = Players.LocalPlayer
            local playerGui = localPlayer:WaitForChild("PlayerGui", 5)
            if not playerGui then return end
            local fullScreen = playerGui:FindFirstChild("FullScreen")
            if not fullScreen then return end
            local currencies = fullScreen:FindFirstChild("Currencies")
            if not currencies then return end
            local scrollingFrame = currencies:FindFirstChild("ScrollingFrame")
            if not scrollingFrame then return end
            local fireElement = scrollingFrame:FindFirstChild("Fire")
            if not fireElement then return end

            local textObj = nil
            if fireElement:IsA("TextLabel") or fireElement:IsA("TextButton") or fireElement:IsA("TextBox") then
                textObj = fireElement
            elseif fireElement:IsA("Frame") then
                textObj = fireElement:FindFirstChildWhichIsA("TextLabel") or fireElement:FindFirstChildWhichIsA("TextButton")
            end
            if textObj then
                autoConvertTextObject = textObj
                autoConvertConnection = autoConvertTextObject:GetPropertyChangedSignal("Text"):Connect(checkAndFireConvert)
                checkAndFireConvert()
            end
        end)
    end

    local function stopAutoConvert()
        if autoConvertConnection then
            autoConvertConnection:Disconnect()
            autoConvertConnection = nil
        end
        autoConvertTextObject = nil
        autoConvertCanFire = true
    end

    MainTab:Toggle({
        Title = "Auto Convert",
        Default = false,
        Callback = function(state)
            autoConvertEnabled = state
            if state then
                stopAutoConvert()
                startAutoConvert()
                WindUI:Notify({ Title = "Auto Convert ON", Content = "Will convert at " .. convertThreshold, Duration = 3, Icon = "refresh-cw" })
