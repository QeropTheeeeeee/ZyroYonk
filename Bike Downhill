    SupportTab:Paragraph({ Title = "Executor", Desc = "Using: " .. executorName .. "\nReport issues in Discord.", Color = Color3.fromHex("#222222") })
    SupportTab:Button({ Title = "Report a Bug", Icon = "bug", Callback = function() copyToClipboard("Bug Report\nExecutor: " .. executorName .. "\nScript: ZyroYonk Hub v1.0.1\n\nDescribe the issue:"); WindUI:Notify({ Title = "Template Copied", Content = "Paste in Discord support channel.", Duration = 4, Icon = "message-square" }) end })

    -- ========== SERVER TAB (SIMPLIFIED, with REAL RESET) ==========
    ServerTab:Section({ Title = "Player Info" })
    ServerTab:Paragraph({
        Title = "ℹ️ Your Details",
        Desc = string.format("Name: %s\nAccount Age: %d days\nHWID: %s", player.Name, player.AccountAge, hwid),
        Color = Color3.fromHex("#222222"),
    })

    ServerTab:Section({ Title = "Server Actions" })
    ServerTab:Button({ Title = "Hop Server", Icon = "repeat", Callback = function() WindUI:Notify({ Title = "Hopping...", Duration = 2 }); TeleportService:Teleport(game.PlaceId) end })
    ServerTab:Button({ Title = "Rejoin", Icon = "log-in", Callback = function() WindUI:Notify({ Title = "Rejoining...", Duration = 2 }); TeleportService:Teleport(game.PlaceId, player) end })
    
    -- REAL RESET using BreakJoints
    ServerTab:Button({
        Title = "Reset Character (Real)",
        Icon = "refresh-cw",
        Callback = function()
            local char = player.Character
            if char then
                char:BreakJoints()
                WindUI:Notify({ Title = "Reset", Content = "Character killed and will respawn.", Duration = 3, Icon = "check-circle" })
            else
                WindUI:Notify({ Title = "Error", Content = "Character not found", Duration = 2, Icon = "alert-triangle" })
            end
        end
    })

    ServerTab:Section({ Title = "Anti AFK" })
    ServerTab:Toggle({
        Title = "Prevent AFK Kick",
        Default = false,
        Callback = function(state)
            antiAfkRunning = state
            if state then
                if antiAfkThread then task.cancel(antiAfkThread) end
                antiAfkThread = task.spawn(antiAfkLoop)
                WindUI:Notify({ Title = "Anti-AFK ON", Duration = 3, Icon = "shield" })
            else
                if antiAfkThread then task.cancel(antiAfkThread); antiAfkThread = nil end
                WindUI:Notify({ Title = "Anti-AFK OFF", Duration = 2, Icon = "shield-off" })
            end
        end
    })
end

