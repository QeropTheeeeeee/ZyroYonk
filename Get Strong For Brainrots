-------------------------------------------------
-- AUTO FARM LOOP
-------------------------------------------------
local function StartAutoFarmLoop()
    task.spawn(function()
        while autoEnabled do

            if selectedPlot == "None" then
                task.wait(1)
                continue
            end

            TeleportToZone(selectedZone)
            task.wait(1)

            local zonePos = GetZonePosition(selectedZone)
            local bestObj = nil
            local bestValue = 0

            if zonePos then
                for _, obj in ipairs(BrainrotsFolder:GetChildren()) do
                    local part = GetPart(obj)
                    if part then
                        local dist = (part.Position - zonePos).Magnitude
                        if dist <= 150 then
                            local value = GetBrainrotValue(obj)
                            if value > bestValue then
                                bestValue = value
                                bestObj = obj
                            end
                        end
                    end
                end
            end

            if not bestObj then
                task.wait(2)
                continue
            end

            local part = GetPart(bestObj)
            if part then
                TeleportToBrainrot(part)
                task.wait(0.5)
                HoldE()
                task.wait(0.5)
            end

            TeleportToPlot(selectedPlot)
            task.wait(1.5)

            task.wait(0.5)
        end
    end)
end

