local function AutoBuyGlovesLoop()
    task.spawn(function()
        while autoBuyGlovesEnabled do
            for _, glove in ipairs(GloveList) do
                if not autoBuyGlovesEnabled then break end

                pcall(function()
                    BuyGloveRemote:InvokeServer(glove)
                end)

                task.wait(0.3)
            end

            task.wait(1)
        end
    end)
end

