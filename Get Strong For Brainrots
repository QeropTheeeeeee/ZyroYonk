-------------------------------------------------
-- HELPERS
-------------------------------------------------
local function GetZonePosition(zoneName)
    local zone = ZoneFloor:FindFirstChild(zoneName)
    if not zone then return nil end

    if zone:IsA("Model") and zone.PrimaryPart then
        return zone.PrimaryPart.Position
    elseif zone:IsA("BasePart") then
        return zone.Position
    else
        local part = zone:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.Position end
    end
end

local function GetPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
    return obj:FindFirstChildWhichIsA("BasePart", true)
end

-------------------------------------------------
-- VALUE DETECTOR
-------------------------------------------------
local function GetBrainrotValue(obj)
    local highest = 0

    local function parse(text)
        if not text then return end

        text = tostring(text)
        local num = string.match(text, "%$?([%d%.]+)%s*([KMBT]?)")
        if num then
            local value = tonumber(num) or 0
            local suffix = string.match(text, "[KMBT]") or ""

            if suffix == "K" then value *= 1e3 end
            if suffix == "M" then value *= 1e6 end
            if suffix == "B" then value *= 1e9 end
            if suffix == "T" then value *= 1e12 end

            if value > highest then
                highest = value
            end
        end
    end

    parse(obj.Name)

    for _, v in pairs(obj:GetAttributes()) do
        parse(v)
    end

    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("StringValue") then
            parse(d.Value)
        elseif d:IsA("TextLabel") then
            parse(d.Text)
        end
    end

    return highest
end

-------------------------------------------------
-- TELEPORTS
-------------------------------------------------
local function TeleportToZone(zoneName)
    local zone = ZoneFloor:FindFirstChild(zoneName)
    if not zone then return end

    local part = GetPart(zone)
    if part then
        rootPart.CFrame = part.CFrame + Vector3.new(0, 5, 0)
    end
end

local function TeleportToPlot(plotName)
    if plotName == "None" then return end

    local plot = BasesTest:FindFirstChild(plotName)
    if not plot then return end

    local ownerSpawn = plot:FindFirstChild("OwnerSpawn")
    if not ownerSpawn then return end

    local part = GetPart(ownerSpawn)
    if part then
        rootPart.CFrame = part.CFrame + Vector3.new(0, 5, 0)
    end
end

local function TeleportToBrainrot(part)
    rootPart.CFrame = part.CFrame + Vector3.new(0, 5, 0)
end

