    local function stopStick()
        if stickConnection then
            stickConnection:Disconnect()
            stickConnection = nil
        end
        currentTargetCrystal = nil
        currentTargetPos = nil
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
