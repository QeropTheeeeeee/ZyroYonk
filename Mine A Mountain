    local function startFly()
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        hum.PlatformStand = true
        flyBodyVelocity = Instance.new("BodyVelocity")
        flyBodyVelocity.Velocity = Vector3.new(0,0,0)
        flyBodyVelocity.MaxForce = Vector3.new(1e9,1e9,1e9)
        flyBodyVelocity.Parent = root
        flyBodyGyro = Instance.new("BodyGyro")
        flyBodyGyro.MaxTorque = Vector3.new(1e9,1e9,1e9)
        flyBodyGyro.D = 100
        flyBodyGyro.CFrame = root.CFrame
        flyBodyGyro.Parent = root
        flyLoopThread = task.spawn(function()
            while flyEnabled do
                local c = player.Character
                if not c then break end
                local r = c:FindFirstChild("HumanoidRootPart")
                if not r then break end
                local cam = workspace.CurrentCamera
                local dir = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
                if dir.Magnitude > 0 then flyBodyVelocity.Velocity = dir.Unit * flySpeed else flyBodyVelocity.Velocity = Vector3.new(0,0,0) end
                flyBodyGyro.CFrame = cam.CFrame
                task.wait()
            end
        end)
    end

    local function stopFly()
        if flyBodyVelocity then flyBodyVelocity:Destroy() end
        if flyBodyGyro then flyBodyGyro:Destroy() end
        if flyLoopThread then task.cancel(flyLoopThread) end
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then hum.PlatformStand = false end
        end
    end

    MiscTab:Toggle({
        Title = "Enable Fly",
        Default = false,
        Callback = function(state)
            flyEnabled = state
            if state then startFly() else stopFly() end
        end
    })

    MiscTab:Slider({
        Title = "Fly Speed",
        Desc = "Adjust flight speed (10-200)",
        Step = 1,
        Value = {
            Min = 10,
            Max = 200,
            Default = 50,
        },
        Callback = function(value)
            flySpeed = value
        end
    })

    player.CharacterAdded:Connect(function()
        if flyEnabled then task.wait(1); startFly() end
    end)

    -- Walk Speed
    MiscTab:Section({ Title = "Walk Speed" })
    local walkSpeedValue = 16
    local moveSpeedEnabled = false
    local speedLoopThread = nil
    local speedHeartbeat = nil

    local function applySpeedToChar(char)
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.WalkSpeed = moveSpeedEnabled and walkSpeedValue or 16
        end
    end

    local function speedLoop()
        while moveSpeedEnabled do
            local char = player.Character
            if char then
                applySpeedToChar(char)
            end
            task.wait(0.2)
        end
    end

    local function updateSpeedLoop()
        if moveSpeedEnabled then
            if speedLoopThread then task.cancel(speedLoopThread) end
            speedLoopThread = task.spawn(speedLoop)
            if not speedHeartbeat then
                speedHeartbeat = player.CharacterAdded:Connect(function(char)
                    task.wait(0.2)
                    if moveSpeedEnabled then
                        applySpeedToChar(char)
                    end
                end)
            end
        else
            if speedLoopThread then task.cancel(speedLoopThread); speedLoopThread = nil end
            if speedHeartbeat then speedHeartbeat:Disconnect(); speedHeartbeat = nil end
            local char = player.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum then hum.WalkSpeed = 16 end
            end
        end
    end

    MiscTab:Slider({
        Title = "Walk Speed",
        Desc = "Set your movement speed (16-120)",
        Step = 1,
        Value = {
            Min = 16,
            Max = 120,
            Default = 16,
        },
        Callback = function(value)
            walkSpeedValue = value
            if moveSpeedEnabled then
                local char = player.Character
                if char then
                    applySpeedToChar(char)
                end
            end
        end
    })

    MiscTab:Toggle({
        Title = "Enable Speed Boost",
        Default = false,
        Callback = function(state)
            moveSpeedEnabled = state
            updateSpeedLoop()
            local char = player.Character
            if char then
                applySpeedToChar(char)
            end
            if state then
                WindUI:Notify({ Title = "Speed Boost", Content = "Enabled (" .. walkSpeedValue .. ")", Duration = 2, Icon = "zap" })
            else
                WindUI:Notify({ Title = "Speed Boost", Content = "Disabled", Duration = 2, Icon = "stop" })
            end
        end
    })

    -- Anti AFK
    MiscTab:Section({ Title = "Anti AFK" })
    MiscTab:Toggle({
        Title = "Prevent AFK Kick",
        Default = false,
        Callback = function(state)
            antiAfkRunning = state
