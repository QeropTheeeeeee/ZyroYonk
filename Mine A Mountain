                    obj.Size = UDim2.new(0, 300, 0, 160) -- bigger for mobile
                    obj.StudsOffset = Vector3.new(0, 3, 0) -- lift above crystal
                    obj.ClipsDescendants = false
                    -- Force all children visible
                    for _, ui in ipairs(obj:GetDescendants()) do
                        if ui:IsA("TextLabel") then
                            ui.Visible = true
                            ui.TextTransparency = 0
                            ui.TextStrokeTransparency = 0
                            ui.TextSize = 24 -- bigger text
                        elseif ui:IsA("ImageLabel") or ui:IsA("ImageButton") then
