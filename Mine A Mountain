    local function isBackpackFull()
        local playerGui = player:FindFirstChild("PlayerGui")
        if not playerGui then return false end
        for _, child in ipairs(playerGui:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                if child.Visible and child.Text then
                    local upper = string.upper(child.Text)
                    if string.find(upper, "FULL") and (upper == "FULL" or child.Text == "Full" or child.Text == "Full!") then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function shouldSell()
        return isBackpackFull()
    end

    local function teleportAndSell()
        if cooldown then return end
        cooldown = true
        isSelling = true

        local sellModel = workspace:FindFirstChild("SellModel")
        if not sellModel then
            sellModel = workspace:FindFirstChild("Things") and workspace.Things:FindFirstChild("SellModel")
        end
        if not sellModel then
            isSelling = false; cooldown = false
            WindUI:Notify({ Title = "Auto Sell", Content = "SellModel not found!", Duration = 3, Icon = "alert-triangle" })
            return
        end

        local targetPart = sellModel.PrimaryPart
        if not targetPart then
            targetPart = sellModel:FindFirstChildWhichIsA("BasePart", true)
        end
        if not targetPart then
            isSelling = false; cooldown = false
            WindUI:Notify({ Title = "Auto Sell", Content = "No BasePart in SellModel!", Duration = 3, Icon = "alert-triangle" })
            return
        end

        local char = player.Character
        if not char or not char.Parent then
            char = player.CharacterAdded:Wait()
        end
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            isSelling = false; cooldown = false
            return
        end

        WindUI:Notify({ Title = "Selling", Content = "Teleporting...", Duration = 1, Icon = "send" })

        local originalCFrame = hrp.CFrame
        local teleportCF = targetPart.CFrame + Vector3.new(0, 3, 0)
        for i = 1, 3 do
            hrp.CFrame = teleportCF
            task.wait(0.05)
        end

        local remote = ReplicatedStorage:FindFirstChild("Remotes")
        if remote then remote = remote:FindFirstChild("SellRequest") end
        if remote then
            local success = false
            for attempt = 1, 3 do
                pcall(function()
                    remote:FireServer("all")
                    success = true
                end)
                if success then break end
                task.wait(0.1)
            end
            if success then
                WindUI:Notify({ Title = "Auto Sell", Content = "Sold backpack!", Duration = 1, Icon = "dollar-sign" })
            else
                WindUI:Notify({ Title = "Auto Sell", Content = "Remote failed to fire!", Duration = 2, Icon = "alert-triangle" })
            end
        else
            WindUI:Notify({ Title = "Auto Sell", Content = "Remote 'SellRequest' not found!", Duration = 3, Icon = "alert-triangle" })
            isSelling = false; cooldown = false
            return
        end

        task.wait(0.3)
        hrp.CFrame = originalCFrame
        isSelling = false
        cooldown = false
    end

    local function autoSellLoop()
        while autoSellRunning do
            if shouldSell() then
                teleportAndSell()
            end
            task.wait(0.3)
        end
    end

