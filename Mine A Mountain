    local function startStick(crystal, part)
        stopStick()
        currentTargetCrystal = crystal
        currentTargetPos = part.Position + Vector3.new(0, 1.5, 0)
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then hum.PlatformStand = true end
        end
        stickConnection = RunService.Heartbeat:Connect(function()
            if not autoMineRunning or not currentTargetCrystal or not currentTargetCrystal.Parent or isSelling then
                stopStick()
                return
            end
            local char = player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            hrp.CFrame = CFrame.new(currentTargetPos)
        end)
    end

    local MAX_ATTEMPTS = 5

    local function mineCrystal(crystal)
        local prompt = crystal:FindFirstChildWhichIsA("ProximityPrompt", true)
        if not prompt then return false end
        local part = crystal:IsA("Model") and (crystal.PrimaryPart or crystal:FindFirstChildWhichIsA("BasePart")) or crystal
        if not part then return false end
        local char = player.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        local targetPos = part.Position + Vector3.new(0, 1.5, 0)
        hrp.CFrame = CFrame.new(targetPos)
        startStick(crystal, part)
        local attempts = 0
        while attempts < MAX_ATTEMPTS and autoMineRunning and crystal and crystal.Parent and not isSelling do
            firePrompt(prompt)
            attempts += 1
            task.wait(0.3)
        end
        stopStick()
        return true
    end

    local function autoMineLoop()
        while autoMineRunning do
            if isSelling then
                stopStick()
                task.wait(0.5)
                continue
            end

            if #selectedMineTiers == 0 then
                task.wait(1)
                continue
            end

            local selectedCodes = {}
            for _, name in ipairs(selectedMineTiers) do
                local code = tierMapping[name]
                if code then table.insert(selectedCodes, code) end
            end
            if #selectedCodes == 0 then
                task.wait(1)
                continue
            end

            local crystalFolder = workspace:FindFirstChild("Things") and workspace.Things:FindFirstChild("Crystals")
            if not crystalFolder then
                task.wait(1)
                continue
            end

            local char = player.Character
            if not char then
                task.wait(1)
                continue
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                task.wait(1)
                continue
            end

            local bestCrystal = nil
            local bestDist = math.huge

            for _, crystal in ipairs(crystalFolder:GetChildren()) do
                local tierCode = string.upper(crystal.Name):match("(T[1-6])")
                if tierCode and table.find(selectedCodes, tierCode) then
                    local part = crystal:IsA("Model") and (crystal.PrimaryPart or crystal:FindFirstChildWhichIsA("BasePart")) or crystal
                    if part then
                        local dist = (hrp.Position - part.Position).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestCrystal = crystal
                        end
                    end
                end
            end

            if not bestCrystal then
                task.wait(2)
                continue
            end

            mineCrystal(bestCrystal)
            task.wait(0.3)
        end
    end

