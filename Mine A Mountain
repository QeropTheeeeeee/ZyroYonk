                local bestCrystal, bestPart, closest = nil, nil, math.huge
                for _, crystal in ipairs(folder:GetChildren()) do
                    if string.upper(crystal.Name):find(selectedTier) then
                        local part = crystal:IsA("Model") and (crystal.PrimaryPart or crystal:FindFirstChildWhichIsA("BasePart")) or crystal
                        if part then
                            local dist = (hrp.Position - part.Position).Magnitude
                            if dist < closest then
                                closest = dist
                                bestCrystal = crystal
                                bestPart = part
                            end
                        end
                    end
                end

                if not bestCrystal or not bestPart then
                    task.wait(2)
                    continue
                end

                local prompt = bestCrystal:FindFirstChildWhichIsA("ProximityPrompt", true)
                if not prompt then
                    task.wait(1)
                    continue
                end

                local maxDist = prompt.MaxActivationDistance
                local ORBIT_RADIUS = math.max(2, math.min(maxDist - 0.5, 5))
                local HEIGHT = 1.0
                local ORBIT_SPEED = 0.5

                local orbitAngle = 0
                local lastTime = tick()

                local function getTargetCFrame(part, angle)
                    local pos = part.Position + Vector3.new(
                        ORBIT_RADIUS * math.cos(angle),
                        HEIGHT,
                        ORBIT_RADIUS * math.sin(angle)
                    )
                    return CFrame.new(pos, part.Position)
                end

                local targetCFrame = getTargetCFrame(bestPart, 0)
                hrp.CFrame = targetCFrame

                WindUI:Notify({ Title = "Auto Mine", Content = "Orbiting " .. selectedTier .. " (" .. bestCrystal.Name .. ")", Duration = 2, Icon = "rotate-cw" })

                hum.PlatformStand = true
                currentHumanoid = hum

                local crystal = bestCrystal
                local part = bestPart
                local active = true

                if followConnection then followConnection:Disconnect() end
                followConnection = RunService.Heartbeat:Connect(function()
                    if not autoMineRunning or not crystal or not crystal.Parent or not part or not part.Parent then
                        active = false
                        followConnection:Disconnect()
                        followConnection = nil
                        if currentHumanoid then currentHumanoid.PlatformStand = false; currentHumanoid = nil end
                        return
                    end

                    local now = tick()
                    local dt = now - lastTime
                    lastTime = now
                    orbitAngle = orbitAngle + ORBIT_SPEED * dt

                    local currentTarget = getTargetCFrame(part, orbitAngle)
                    local dist = (hrp.Position - currentTarget.Position).Magnitude
                    if dist > 1.5 then
                        hrp.CFrame = currentTarget
                    else
                        hrp.CFrame = hrp.CFrame:Lerp(currentTarget, 0.7)
