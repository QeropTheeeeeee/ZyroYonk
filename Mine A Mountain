    -- 🔥 IMPROVED & SECURE BACKPACK FULL DETECTION
    local function isBackpackFull()
        local playerGui = player:FindFirstChild("PlayerGui")
        if not playerGui then return false end

        -- Scan ALL descendants of PlayerGui
        for _, child in ipairs(playerGui:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                -- Must be visible and have text
                if child.Visible and child.Text and child.Text ~= "" then
                    local upper = string.upper(child.Text)
                    -- Detect "FULL" anywhere in the text
                    if string.find(upper, "FULL") then
                        -- Optional: avoid false positives like "FULLNESS" or "FULLY"
                        -- by checking if the text is exactly "FULL" or "Full"
                        if upper == "FULL" or child.Text == "Full" or child.Text == "Full!" then
                            return true
                        end
                        -- If the text contains "FULL" but also other words, still consider it if
                        -- the parent is likely the backpack UI
                        local parent = child.Parent
                        if parent and parent.Name and string.find(string.upper(parent.Name), "BACKPACK") then
                            return true
                        end
                    end
                end
            end
        end
        return false
    end

    local function teleportAndSell()
        if cooldown then return end
        cooldown = true

        local sellPart = workspace:FindFirstChild("Things") and workspace.Things:FindFirstChild("SellModel") and workspace.Things.SellModel:FindFirstChild("SellPart")
        if not sellPart then
            warn("SellPart not found!")
            cooldown = false
            return
        end

        local char = player.Character
        if not char or not char.Parent then
            char = player.CharacterAdded:Wait()
        end
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            cooldown = false
            return
        end

        -- Notify that we detected a full backpack (optional debug)
        WindUI:Notify({ Title = "Backpack Full", Content = "Selling...", Duration = 1, Icon = "package" })

        -- Save original position
