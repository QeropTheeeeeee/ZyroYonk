                        elseif ui:IsA("UIStroke") then
                            ui.Enabled = true
                            ui.Thickness = 2
                        end
                    end
                end)
            end
        end
    end

    local function espLoop()
        while espRunning do
            for _, folder in ipairs(Folders) do
                forceESP(folder)
            end
            task.wait(0.03)
        end
