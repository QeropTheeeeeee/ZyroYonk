                        ui.TextTransparency = 0
                        ui.TextStrokeTransparency = 0
                        ui.TextSize = 24
                    elseif ui:IsA("ImageLabel") or ui:IsA("ImageButton") then
                        ui.Visible = true
                        ui.ImageTransparency = 0
                    elseif ui:IsA("UIStroke") then
                        ui.Enabled = true
                        ui.Thickness = 2
                    end
                end
            end)
        end
    end

    local function enableESP()
        -- Clean previous connections
        for _, conn in ipairs(espConnections) do
            pcall(conn.Disconnect, conn)
        end
        espConnections = {}
        for _, folder in ipairs(Folders) do
            local conn = folder.DescendantAdded:Connect(onDescendantAdded)
            table.insert(espConnections, conn)
        end
        if espThread then task.cancel(espThread) end
        espThread = task.spawn(espLoop)
    end

    local function disableESP()
        espRunning = false
        if espThread then task.cancel(espThread); espThread = nil end
        for _, conn in ipairs(espConnections) do
            pcall(conn.Disconnect, conn)
        end
        espConnections = {}
        -- Optionally disable all billboards
        for _, folder in ipairs(Folders) do
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj.Name == "CrystalHover" and obj:IsA("BillboardGui") then
