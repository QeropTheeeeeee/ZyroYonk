    if raw then pcall(function() Response = HttpService:JSONDecode(raw) end) end
    local onlineCount = Response and Response.approximate_presence_count or "?"
    local totalCount = Response and Response.approximate_member_count or "?"
    local guildName = (Response and Response.guild and Response.guild.name) or "ZyroYonk Hub Discord"
    local iconUrl = nil
    if Response and Response.guild and Response.guild.id and Response.guild.icon then
        iconUrl = "https://cdn.discordapp.com/icons/" .. tostring(Response.guild.id) .. "/" .. tostring(Response.guild.icon) .. ".png?size=256"
    end
    
    SupportTab:Section({ Title = "Join our Discord", Desc = "Get updates, report bugs, and hang out with the community!" })
    
    local cardProps = { 
        Title = guildName, 
        Desc = "🟢 Online: " .. onlineCount .. "   👥 Members: " .. totalCount, 
        ImageSize = 64,
        ThumbnailSize = 100,
        Color = Color3.fromHex("#2C2F33"),
        Buttons = { 
            { 
                Title = "Copy Invite", 
                Callback = function() 
                    copyToClipboard("https://discord.gg/" .. InviteCode)
                    WindUI:Notify({ Title = "Copied!", Content = "Invite link copied to clipboard", Duration = 2, Icon = "clipboard-check" }) 
                end 
            },
            { 
                Title = "Join Discord", 
                Callback = function()
                    if syn and syn.websocket then
                        pcall(function() syn.websocket:connect("discord.gg/" .. InviteCode) end)
                    elseif openUrl then
                        openUrl("https://discord.gg/" .. InviteCode)
                    else
                        copyToClipboard("https://discord.gg/" .. InviteCode)
                        WindUI:Notify({ Title = "Link Copied!", Content = "Paste in browser to join", Duration = 3, Icon = "globe" })
                    end
                end
            }
        } 
    }
    if iconUrl then cardProps.Image = iconUrl end
    SupportTab:Paragraph(cardProps)

    SupportTab:Section({ Title = "Help & Information" })
    SupportTab:Paragraph({
        Title = "📌 Executor Compatibility",
        Desc = "Currently using: **" .. executorName .. "**\n\nIf you encounter issues, please report them in our Discord.",
        Color = Color3.fromHex("#2C2F33"),
        Image = "https://cdn-icons-png.flaticon.com/512/1828/1828665.png",
        ImageSize = 40
    })
    
    SupportTab:Button({
        Title = "Report a Bug",
        Icon = "bug",
        Callback = function()
            copyToClipboard("Bug Report - Executor: " .. executorName .. " - Please describe the issue:")
            WindUI:Notify({ Title = "Template Copied!", Content = "Paste in Discord support channel", Duration = 4, Icon = "message-square" })
        end
    })

    -- ========== REQUEST TAB ==========
    local RequestTab = Window:Tab({ Title = "Request", Icon = "mail" })
    
    RequestTab:Section({ Title = "📬 Send a Request" })
    
    RequestTab:Paragraph({
        Title = "✨ Developer Feedback & Suggestions",
        Desc = "Use this form to send ideas, bug reports, or feature requests directly to the developer. Your message will be sent via Discord webhook. Only the developer will see it.",
        Color = Color3.fromHex("#2C2F33"),
        Image = "https://cdn-icons-png.flaticon.com/512/456/456212.png",
        ImageSize = 50
    })
    
    local requestMessage = ""
    RequestTab:Input({
        Title = "Your Message",
        Desc = "Type your request or suggestion here",
        Placeholder = "e.g., Add auto farm feature...",
        Callback = function(text)
            requestMessage = text
        end
    })
    
    RequestTab:Button({
        Title = "Send Request",
        Icon = "send",
        Callback = function()
            if requestMessage == nil or requestMessage == "" then
                WindUI:Notify({
                    Title = "Error",
                    Content = "Please enter a message first",
                    Duration = 3,
                    Icon = "alert-circle"
                })
                return
            end
            
            local webhookUrl = "https://discord.com/api/webhooks/1495483361328889960/cc1tTgDQtLElx0u3syxvll5xcvy43cTDTAvpTD00rn4J66QwV-vZSJhh7109bEiKX_Qe"
            
            local playerName = player.Name
            local executor = executorName
            local fullMessage = string.format("**New Request from %s** (Executor: %s)\n```%s```", playerName, executor, requestMessage)
            
            local data = {
                content = fullMessage,
                username = "ZyroYonk Request",
                avatar_url = profileIconUrl
            }
            
            local jsonData = HttpService:JSONEncode(data)
            
            local success = false
            local responseBody = nil
            
            if syn and syn.request then
                success, responseBody = pcall(function()
                    return syn.request({
                        Url = webhookUrl,
                        Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = jsonData
                    })
                end)
            elseif request then
                success, responseBody = pcall(function()
                    return request({
                        Url = webhookUrl,
                        Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = jsonData
                    })
                end)
            elseif http and http.request then
                success, responseBody = pcall(function()
                    return http.request({
                        Url = webhookUrl,
                        Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = jsonData
                    })
                end)
            elseif http_request then
                success, responseBody = pcall(function()
                    return http_request({
                        Url = webhookUrl,
                        Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = jsonData
                    })
                end)
            else
                WindUI:Notify({
                    Title = "Error",
                    Content = "Your executor does not support HTTP requests",
                    Duration = 4,
                    Icon = "alert-octagon"
                })
                return
            end
            
            if success then
                WindUI:Notify({
                    Title = "Request Sent!",
                    Content = "Your message has been delivered to the developer.",
                    Duration = 3,
                    Icon = "check-circle"
                })
                requestMessage = ""
            else
                WindUI:Notify({
                    Title = "Failed to Send",
                    Content = "Error: " .. tostring(responseBody),
                    Duration = 4,
                    Icon = "alert-triangle"
                })
            end
        end
    })
end

