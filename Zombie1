-- ================== WEBHOOK FUNCTION (fixed 30 seconds) ==================
local function sendWebhook(webhookUrl, avatarUrl)
    -- Wait for leaderstats and GUI elements
    repeat task.wait() until player:FindFirstChild("leaderstats")
    local leaderstats = player.leaderstats
    
    repeat task.wait(0.1) until 
        player.PlayerGui:FindFirstChild("MainGui") and 
        player.PlayerGui.MainGui:FindFirstChild("WaveLabel") and
        player.PlayerGui.MainGui:FindFirstChild("VoidShardsDisplay")
    
    local WaveLabel = player.PlayerGui.MainGui.WaveLabel
    local VoidShardsDisplay = player.PlayerGui.MainGui.VoidShardsDisplay
    
    local function getShards()
        local possible = {"Text", "Label", "Value", "Amount", "Count", "TextLabel"}
        for _, name in ipairs(possible) do
            local val = VoidShardsDisplay:FindFirstChild(name)
            if val and val.Text then
                return tostring(val.Text)
            end
        end
        if VoidShardsDisplay.Text then
            return tostring(VoidShardsDisplay.Text)
        end
        return "N/A"
    end
    
    local wave    = tostring(WaveLabel.Text or "N/A")
    local shards  = getShards()
    local kills   = tostring(leaderstats:FindFirstChild("Kills") and leaderstats.Kills.Value or "N/A")
    local crystal = tostring(leaderstats:FindFirstChild("Crystals") and leaderstats.Crystals.Value or "N/A")
    
    local payload = HttpService:JSONEncode({
        username = "Stats Tracker",
        avatar_url = avatarUrl,
        embeds = {{
            title = "📋  " .. player.Name .. " — Stats",
            color = 0x5865F2,
            fields = {
                { name = "🌊  Wave",     value = wave,    inline = false },
                { name = "🔮  Shards",   value = shards,  inline = false },
                { name = "⚔️  Kills",    value = kills,   inline = false },
                { name = "💎  Crystals", value = crystal, inline = false },
            },
            footer = { text = "📅 " .. os.date("%B %d, %Y  •  %I:%M %p") }
        }}
    })
    
    local req = (syn and syn.request) or (http and http.request) or request
    if not req then return false end
    
    local success, res = pcall(function()
        return req({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = payload
        })
    end)
    
    return success
end

