-- ===== Anti‑AFK (improved) =====
local antiAfkRunning = false
local antiAfkThread = nil

local function antiAfkLoop()
    while antiAfkRunning do
        local success, vu = pcall(function() return game:GetService("VirtualUser") end)
        if success and vu then
            pcall(function()
                vu:CaptureController()
                vu:ClickButton2(Vector2.new())
            end)
        else
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local original = hrp.CFrame
                    hrp.CFrame = original + Vector3.new(0, 0.01, 0)
                    task.wait(0.05)
                    hrp.CFrame = original
                end
            end
        end
        task.wait(math.random(30, 45))
    end
end

local function restartAntiAfkIfNeeded()
    if antiAfkRunning then
        if antiAfkThread then task.cancel(antiAfkThread) end
        antiAfkThread = task.spawn(antiAfkLoop)
    end
end
player.CharacterAdded:Connect(restartAntiAfkIfNeeded)

