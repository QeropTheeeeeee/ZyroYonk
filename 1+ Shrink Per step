    -- Helper: get current level from GUI
    local function getCurrentLevel()
        local levelLabel = player.PlayerGui:FindFirstChild("Main") and 
                           player.PlayerGui.Main:FindFirstChild("Down") and
                           player.PlayerGui.Main.Down:FindFirstChild("Main") and
                           player.PlayerGui.Main.Down.Main:FindFirstChild("Main") and
