    SupportTab:Button({ Title = "Report a Bug", Icon = "bug", Callback = function() copyToClipboard("Bug Report\nExecutor: " .. executorName .. "\nScript: StarForge Hub v1.0\n\nDescribe the issue:"); WindUI:Notify({ Title = "Template Copied", Content = "Paste in Discord support channel.", Duration = 4, Icon = "message-square" }) end })
    
    -- ========== SERVER TAB ==========
    local ServerTab = Window:Tab({ Title = "Server", Icon = "server" })
    ServerTab:Section({ Title = "Player Info" })
    ServerTab:Paragraph({
        Title = "ℹ️ Your Details",
        Desc = string.format("Name: %s\nAccount Age: %d days\nHWID: %s", player.Name, player.AccountAge, hwid),
        Color = Color3.fromHex("#222222"),
    })
    ServerTab:Section({ Title = "Server Actions" })
    ServerTab:Button({ Title = "Hop Server", Icon = "repeat", Callback = function() WindUI:Notify({ Title = "Hopping...", Duration = 2 }); TeleportService:Teleport(game.PlaceId) end })
    ServerTab:Button({ Title = "Rejoin", Icon = "log-in", Callback = function() WindUI:Notify({ Title = "Rejoining...", Duration = 2 }); TeleportService:Teleport(game.PlaceId, player) end })
    ServerTab:Button({ Title = "Reset Character", Icon = "refresh-cw", Callback = resetCharacter })
    ServerTab:Section({ Title = "Anti AFK" })
    ServerTab:Toggle({
        Title = "Prevent AFK Kick",
        Desc = "Simulates activity every 30 seconds",
        Default = false,
        Callback = function(state)
            antiAfkRunning = state
            if state then
                if antiAfkThread then task.cancel(antiAfkThread) end
                antiAfkThread = task.spawn(antiAfkLoop)
                WindUI:Notify({ Title = "Anti-AFK ON", Content = "You won't be kicked", Duration = 3, Icon = "shield" })
            else
                if antiAfkThread then task.cancel(antiAfkThread); antiAfkThread = nil end
                WindUI:Notify({ Title = "Anti-AFK OFF", Duration = 2, Icon = "shield-off" })
            end
        end
    })
end

