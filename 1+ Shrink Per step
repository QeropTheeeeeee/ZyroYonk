        while autoWinSmartW1 do
            local level = getCurrentLevel()
            if level and level > 0 then
                local best = getBestRoomW1(level)
                if best then
                    local success = teleportToWin(best)
                    if success then
                        WindUI:Notify({ Title = "W1 Smart Win", Content = "Completed room " .. best.Name, Duration = 1, Icon = "check" })
                    end
                end
            end
            for i = 1, math.floor(winSmartDelay) do
