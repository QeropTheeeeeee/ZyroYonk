local function fireSatchel()
    remote:FireServer(buffer.fromstring("\"\028\v\006Source\v\016SatchelEquipBest\000"))
    remote:FireServer(buffer.fromstring("\018\028\v\006Action\v\fRequestState\000"))
end

local function fireActionOld()
    remote:FireServer(buffer.fromstring("\018\005\005"))
    remote:FireServer(buffer.fromstring("\018\028\v\006Action\v\fRequestState\000"))
end

local function fireActionAlt()
    remote:FireServer(buffer.fromstring("\018\005\001"))
    remote:FireServer(buffer.fromstring("\018\028\v\006Action\v\fRequestState\000"))
end

local function fireActionNew()
    remote:FireServer(buffer.fromstring("\018\005\004"))
    remote:FireServer(buffer.fromstring("\018\028\v\006Action\v\fRequestState\000"))
end

local function fireRebirth()
    -- Rebirth
    remote:FireServer(buffer.fromstring("\022\028\v\006Action\v\aRebirth\000"))

    -- Multiple state syncs (your full script)
    remote:FireServer(buffer.fromstring("\018\028\v\006Action\v\fRequestState\000"))
    remote:FireServer(buffer.fromstring("\018\028\v\006Action\v\fRequestState\000\018\028\v\006Action\v\fRequestState\000"))
    remote:FireServer(buffer.fromstring("$\028\v\006Action\v\fRequestState\000\018\028\v\006Action\v\fRequestState\000#\v\004Sync\029\v\004Sync\028\000#\v\004Sync"))
end

local function fireFloorAction()
    remote:FireServer(buffer.fromstring(" \028\v\005Floor\005\002\000"))
    remote:FireServer(buffer.fromstring("\018\028\v\006Action\v\fRequestState\000"))
end

