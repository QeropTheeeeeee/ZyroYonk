    -------------------------------------------------
    -- AUTO FARM TAB
    -------------------------------------------------
    local FarmTab = Window:Tab({
        Title = "Auto Farm Brainrots",
        Icon = "repeat",
    })

    local selectedZone = nil
    local selectedPlot = nil
    local farming = false

    local world = workspace:WaitForChild("_WorldVehicles")
    local plots = workspace:WaitForChild("Plots")

    local zones = {
        Common = world:WaitForChild("CommonZone"),
        Uncommon = world:WaitForChild("UncommonZone"),
        Rare = world:WaitForChild("RareZone"),
        Epic = world:WaitForChild("EpicZone"),
        Legendary = world:WaitForChild("LegendaryZone"),
        Mythical = world:WaitForChild("MythicalZone"),
        Secret = world:WaitForChild("SecretZone"),
        Divine = world:WaitForChild("DivineZone"),
        Godly = world:WaitForChild("GodlyZone"),
    }

    local plotList = {
        ["Plot 1"] = "1",
        ["Plot 2"] = "2",
        ["Plot 3"] = "3",
        ["Plot 4"] = "4",
        ["Plot 5"] = "5",
    }

    local function holdE(prompt, duration)
        prompt:InputHoldBegin()
        task.wait(duration)
        prompt:InputHoldEnd()
    end

    local function getHRP()
        local char = player.Character or player.CharacterAdded:Wait()
        return char:WaitForChild("HumanoidRootPart")
    end

    local function getTarget(zone)
        for _, child in ipairs(zone:GetChildren()) do
            if child:IsA("BasePart") then
                return child
            elseif child:IsA("Model") then
                for _, v in ipairs(child:GetChildren()) do
                    if v:IsA("BasePart") then
                        return v
                    end
                end
            end
        end
    end

    local function collect()
        local zone = zones[selectedZone]
        local plotId = plotList[selectedPlot]

        if not zone or not plotId then return end

        local hrp = getHRP()
        local target = getTarget(zone)
        local returnPart = plots[plotId].Multipliers

        if target then
            hrp.CFrame = target.CFrame + Vector3.new(0,3,0)
            RunService.RenderStepped:Wait()
            task.wait(0.5)

            local prompt = target:FindFirstChildWhichIsA("ProximityPrompt")
            if prompt then
                holdE(prompt, 0.6)

                if returnPart then
                    hrp.CFrame = returnPart.CFrame + Vector3.new(0,3,0)
                end
            end
        end
    end

    FarmTab:Dropdown({
        Title = "Select Zone",
        Values = {
            "Common","Uncommon","Rare","Epic",
            "Legendary","Mythical","Secret","Divine","Godly"
        },
        Callback = function(value)
            selectedZone = value
        end
    })

    FarmTab:Dropdown({
        Title = "Select Plot",
        Values = {
            "Plot 1","Plot 2","Plot 3","Plot 4","Plot 5"
        },
        Callback = function(value)
            selectedPlot = value
        end
    })

    FarmTab:Toggle({
        Title = "Start Auto Farm",
        Desc = "Requires Zone + Plot selected",
        Callback = function(state)

            if state and (not selectedZone or not selectedPlot) then
                WindUI:Notify({
                    Title = "Missing Selection!",
                    Content = "Select BOTH Zone and Plot first.",
                    Duration = 4
                })
                return
            end

            farming = state

            if farming then
                task.spawn(function()
                    while farming do
                        pcall(collect)
                        task.wait(0.5)
                    end
                end)
            end
        end
    })

