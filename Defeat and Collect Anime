            AutoFarm = state
            if not state then return end

            task.spawn(function()
                while AutoFarm do
                    if not SelectedZone then
                        task.wait(0.5)
                        continue
                    end

                    local zoneName = ZonePaths[SelectedZone][1]
                    local spawnZone = workspace:WaitForChild("Areas")
                        :WaitForChild(zoneName)
                        :WaitForChild("_spawnZone")

                    local char = player.Character
                    if not char then task.wait(0.5) continue end
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if not hrp then task.wait(0.5) continue end

                    local obj, part = getTarget(spawnZone)

                    if obj and part then
                        hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                        task.wait(0.3)

                        local prompt = nil
                        local currentObj = obj

                        while currentObj and currentObj.Parent and AutoFarm do
                            pcall(function()
                                remote:FireServer(buffer.fromstring("!"))
                            end)
                            task.wait(0.2)
                            prompt = getPrompt(currentObj)
                            if prompt then break end
                        end

                        if prompt and AutoFarm then
                            task.wait(0.3)
                            prompt:InputHoldBegin()
                            task.wait(0.6)
                            prompt:InputHoldEnd()
                            task.wait(0.2)
                            hrp.CFrame = reachSoul.CFrame + Vector3.new(0, 5, 0)
                        end

                        while currentObj and currentObj.Parent and AutoFarm do
