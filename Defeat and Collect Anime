    -- ── Auto Farm State ──────────────────────────────────────
    local AutoFarm     = false
    local SelectedZone = nil

    -- Zone boundary check
    local function isInsideZone(spawnZone, pos)
        local relative = spawnZone.CFrame:PointToObjectSpace(pos)
        return math.abs(relative.X) <= spawnZone.Size.X / 2
           and math.abs(relative.Y) <= spawnZone.Size.Y / 2
           and math.abs(relative.Z) <= spawnZone.Size.Z / 2
    end

    -- Get next debris inside the zone
    local function getTarget(spawnZone)
        for _, obj in ipairs(debrisFolder:GetChildren()) do
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
            if part and isInsideZone(spawnZone, part.Position) then
                return obj, part
            end
        end
        return nil, nil
    end

    -- Find ProximityPrompt inside object
    local function getPrompt(obj)
        local attachment = obj:FindFirstChild("PromptAttachment", true)
        if attachment then
            return attachment:FindFirstChildWhichIsA("ProximityPrompt")
        end
        return nil
    end

