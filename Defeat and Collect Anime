                        end
                    end

                    task.wait(0.2)  -- delay between teleports
                end

                -- Auto turn off toggle when finished
                if teleportActive then
                    WindUI:Notify({ Title = "Done", Content = "Finished teleporting through Plot " .. selectedPlot .. " (Slots 1-50)", Duration = 3 })
                end
                teleportActive = false
            end)
        end,
    })

