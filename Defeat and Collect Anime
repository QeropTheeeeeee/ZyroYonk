    -- Function to find which plot belongs to the player
    local function findMyPlot()
        local plotsFolder = workspace:FindFirstChild("Plots")
        if not plotsFolder then return nil end
        local allPlots = {}
        for i, child in ipairs(plotsFolder:GetChildren()) do
            allPlots[i] = child
        end
        local playerName = player.Name
        for idx, plot in ipairs(allPlots) do
            -- Check for a StringValue named "Owner" with player's name
            local ownerVal = plot:FindFirstChild("Owner")
            if ownerVal and ownerVal:IsA("StringValue") and ownerVal.Value == playerName then
                return idx
            end
            -- Check for a part or object named exactly the player's name
            if plot:FindFirstChild(playerName) then
                return idx
            end
            -- Search descendants for text containing the player name
            for _, descendant in ipairs(plot:GetDescendants()) do
                if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
                    if descendant.Text and descendant.Text:find(playerName) then
                        return idx
                    end
                elseif descendant.Name == playerName then
                    return idx
                end
            end
        end
        return nil
    end

