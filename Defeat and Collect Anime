    -- Toggle that starts/stops teleport through slots 1-50 of the chosen plot
    SpawnTab:Toggle({
        Title       = "Auto Collect",
        Description = "Teleports you to each _cashpad.top of the selected plot",
        Default     = false,
        Callback    = function(state)
            -- Stop any existing teleport task
            if teleportTask then
                task.cancel(teleportTask)
                teleportTask = nil
            end

            teleportActive = state

            if not state then return end

            teleportTask = task.spawn(function()
                local plotsFolder = workspace:FindFirstChild("Plots")
                if not plotsFolder then
                    WindUI:Notify({ Title = "Error", Content = "Plots folder not found!", Duration = 3 })
                    teleportActive = false
                    return
                end

                -- Get all plots as an array (index 1 = first child)
                local allPlots = {}
                for _, child in ipairs(plotsFolder:GetChildren()) do
                    table.insert(allPlots, child)
                end

                -- Check if selected plot index exists
                if selectedPlot < 1 or selectedPlot > #allPlots then
                    WindUI:Notify({ Title = "Error", Content = "Plot " .. selectedPlot .. " does not exist!", Duration = 3 })
                    teleportActive = false
                    return
                end

                local plot = allPlots[selectedPlot]
                if not plot then
                    WindUI:Notify({ Title = "Error", Content = "Plot " .. selectedPlot .. " not found!", Duration = 3 })
                    teleportActive = false
                    return
                end

                -- Loop through slots 1 to 50 for this single plot
                for slotNum = 1, 50 do
                    if not teleportActive then break end

                    -- Build path: plot.Components.Server.Slot<num>._cashpad.top
                    local components = plot:FindFirstChild("Components")
                    local server = components and components:FindFirstChild("Server")
                    local slot = server and server:FindFirstChild("Slot" .. slotNum)
                    local cashpad = slot and slot:FindFirstChild("_cashpad")
                    local top = cashpad and cashpad:FindFirstChild("top")

                    if top and top:IsA("BasePart") then
                        local char = player.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        if hrp then
