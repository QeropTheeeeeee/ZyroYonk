-- Function to scan Brainrots folder for Divine, Og, and Admin NPCs
local function scanForSpecialNPCs()
    local brainrots = workspace.Game:FindFirstChild("Brainrots")
    if not brainrots then return end
    
    divineNPCs = {}
    ogNPCs = {}
    adminNPCs = {}
    
    for _, child in ipairs(brainrots:GetChildren()) do
        local name = child.Name
        if string.find(string.lower(name), "divine") then
            table.insert(divineNPCs, name)
        elseif string.find(string.lower(name), "og") then
            table.insert(ogNPCs, name)
        elseif string.find(string.lower(name), "admin") then
            table.insert(adminNPCs, name)
        end
    end
    
    print("Found Divine NPCs: " .. #divineNPCs)
    print("Found Og NPCs: " .. #ogNPCs)
    print("Found Admin NPCs: " .. #adminNPCs)
end

-- Function to teleport to a part
local function teleport(part)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and part then
        hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    end
end

-- Function to hold E on a model for 0.6 seconds
local function holdE(model, time)
    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(time)
        vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
end

-- Main Brainrot farm cycle
local function doBrainrotCycle()
    if not autoBrainrotEnabled then return end
    if autoBrainrotRunning then return end
    
    autoBrainrotRunning = true
    
    local char = player.Character
    if not char then 
        autoBrainrotRunning = false
        return 
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        autoBrainrotRunning = false
        return 
    end
    
    local brainrots = workspace.Game:FindFirstChild("Brainrots")
    if not brainrots then
        autoBrainrotRunning = false
        return
    end
    
    -- Select which NPC list to use
    local npcList
    if selectedRarity == "Common" then
        npcList = commonNPCs
    elseif selectedRarity == "Rare" then
        npcList = rareNPCs
    elseif selectedRarity == "Epic" then
        npcList = epicNPCs
    elseif selectedRarity == "Legendary" then
        npcList = legendaryNPCs
    elseif selectedRarity == "Mythical" then
        npcList = mythicalNPCs
    elseif selectedRarity == "Secret" then
        npcList = secretNPCs
    elseif selectedRarity == "Celestial" then
        npcList = celestialNPCs
    elseif selectedRarity == "Divine" then
        npcList = divineNPCs
    elseif selectedRarity == "Og" then
        npcList = ogNPCs
    elseif selectedRarity == "Admin" then
        npcList = adminNPCs
    else
        npcList = commonNPCs
    end
    
    if #npcList == 0 then
        autoBrainrotRunning = false
        return
    end
    
    local currentNPC = npcList[currentIndex]
    local target = brainrots:FindFirstChild(currentNPC)
    
    if target then
        local part = target:IsA("BasePart") and target or target:FindFirstChildWhichIsA("BasePart", true)
        
        if part then
            -- Teleport to NPC
            teleport(part)
            task.wait(0.3)
            
            -- Hold E for 0.6 seconds
            holdE(target, 0.7)
            task.wait(0.3)
            
            -- Teleport to TemporarySpawn
            local spawn = workspace:FindFirstChild("TemporarySpawn")
            if spawn then
                local spawnPart = spawn:IsA("BasePart") and spawn or spawn:FindFirstChildWhichIsA("BasePart", true)
                teleport(spawnPart)
            end
            
            -- Move to next NPC (loop back to start)
            currentIndex = currentIndex + 1
            if currentIndex > #npcList then
                currentIndex = 1
            end
        end
    else
        -- If NPC not found, move to next one
        currentIndex = currentIndex + 1
        if currentIndex > #npcList then
            currentIndex = 1
        end
    end
    
    autoBrainrotRunning = false
end

-- Start auto farm (continuous loop)
local function startAutoBrainrot()
    if autoBrainrotEnabled then return end
    autoBrainrotEnabled = true
    autoBrainrotRunning = false
    currentIndex = 1 -- Reset to first NPC when starting
    
    task.spawn(function()
        while autoBrainrotEnabled do
            doBrainrotCycle()
            if autoBrainrotEnabled then
                task.wait(0.3)
            end
        end
    end)
    
    print("✅ Auto Brainrot Farm Started (" .. selectedRarity .. ")")
    WindUI:Notify({ Title = "Auto Brainrot Started", Content = "Farming " .. selectedRarity .. " NPCs (Looping)", Duration = 3, Icon = "play" })
end

local function stopAutoBrainrot()
