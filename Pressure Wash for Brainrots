-- Function to click on a lucky block
local function clickLuckyBlock(block)
    if not block then return end
    
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Find the click detector or proximity prompt
    local clickDetector = block:FindFirstChildWhichIsA("ClickDetector", true)
    local proximityPrompt = block:FindFirstChildWhichIsA("ProximityPrompt", true)
    
    if clickDetector then
        -- Teleport near the block
        if block:IsA("BasePart") then
            hrp.CFrame = block.CFrame + Vector3.new(0, 3, 0)
        elseif block:IsA("Model") then
            local primaryPart = block.PrimaryPart or block:FindFirstChildWhichIsA("BasePart")
            if primaryPart then
                hrp.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0)
            end
        end
        task.wait(0.2)
        
        -- Fire click detector
        fireclickdetector(clickDetector)
    elseif proximityPrompt then
        -- Teleport near the block
        if block:IsA("BasePart") then
            hrp.CFrame = block.CFrame + Vector3.new(0, 3, 0)
        elseif block:IsA("Model") then
            local primaryPart = block.PrimaryPart or block:FindFirstChildWhichIsA("BasePart")
            if primaryPart then
                hrp.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0)
            end
        end
        task.wait(0.2)
        
        -- Hold E for 0.3 seconds
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.3)
        vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
end

