-- ================== NPC FARM FUNCTIONS ==================
local function getMoneyRate(npc)
    local best = 0
    local rateType = "unknown"
    
    for _, obj in ipairs(npc:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextBox") then
            local text = obj.Text or ""
            
            local perSecond = text:match("(%d+[,%.]?%d*)%s*%/s")
            local dollarSign = text:match("%$(%d+[,%.]?%d*)")
            local rateWord = text:match("rate[:%s]*(%d+[,%.]?%d*)")
            
            local raw = perSecond or dollarSign or rateWord
            if raw then
                local cleaned = raw:gsub(",", ""):gsub("%.", "")
                local val = tonumber(cleaned) or 0
                if val > best then 
                    best = val 
                    rateType = "text"
                end
            end
            
            for raw in text:gmatch("%$(%d+[,%.]?%d*)") do
                local cleaned = raw:gsub(",", ""):gsub("%.", "")
                local val = tonumber(cleaned) or 0
                if val > best then 
                    best = val 
                    rateType = "dollar"
                end
            end
        end

        if obj:IsA("NumberValue") or obj:IsA("IntValue") or obj:IsA("FloatValue") then
            local name = obj.Name:lower()
            if name:find("rate") or name:find("dps") or name:find("money") or name:find("earn") or name:find("persec") then
                if obj.Value > best then 
                    best = obj.Value 
                    rateType = "value"
                end
            end
        end
        
        local success, rateAttr = pcall(function()
            return npc:GetAttribute("Rate") or npc:GetAttribute("MoneyRate") or npc:GetAttribute("DPS")
        end)
        if success and rateAttr and type(rateAttr) == "number" then
            if rateAttr > best then
                best = rateAttr
                rateType = "attribute"
            end
        end
    end

    return best, rateType
end

local function findBestNPC()
    local fieldZone = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Zones") and workspace.Map.Zones:FindFirstChild("Field") and workspace.Map.Zones.Field:FindFirstChild("NPC")
    if not fieldZone then return nil end
    
    local npcList = {}

    for _, npc in ipairs(fieldZone:GetChildren()) do
        local rate, rateType = getMoneyRate(npc)
        table.insert(npcList, { npc = npc, rate = rate, rateType = rateType })
    end

    table.sort(npcList, function(a, b)
        return a.rate > b.rate
    end)

    return npcList[1]
end

local function doNPCFarmCycle()
    if not autoFarmEnabled then return end
    if autoFarmRunning then return end
    
    autoFarmRunning = true
    
    local character = player.Character
    if not character then 
        autoFarmRunning = false
        return 
    end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then 
        autoFarmRunning = false
        return 
    end
    
    local fieldZone = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Zones") and workspace.Map.Zones:FindFirstChild("Field") and workspace.Map.Zones.Field:FindFirstChild("NPC")
    local spawnTP = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("SpawnLocations") and workspace.Map.SpawnLocations:FindFirstChild("SpawnLocationTP")
    
    if not fieldZone or not spawnTP then
        autoFarmRunning = false
        return
    end
    
    local best = findBestNPC()
    
    if best and best.npc and best.rate > 0 then
        local targetPart = best.npc.PrimaryPart
        if not targetPart then
            for _, d in ipairs(best.npc:GetDescendants()) do
                if d:IsA("BasePart") and not d:IsA("SelectionBox") then
                    targetPart = d
                    break
                end
            end
        end

        if targetPart then
            -- Teleport to NPC
            rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 5, 0)
            task.wait(0.15)

            -- Hold E for 0.3s
            local prompt = best.npc:FindFirstChildWhichIsA("ProximityPrompt", true)
            local click = best.npc:FindFirstChildWhichIsA("ClickDetector", true)

            if prompt then
                fireProximityPrompt(prompt)
                task.wait(0.3)
            elseif click then
                fireClickDetector(click)
                task.wait(0.3)
            else
                local vim = game:GetService("VirtualInputManager")
                vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.3)
                vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end
            
            -- DOWNWARD TWEEN to spawn
            local spawnTargetPart = spawnTP:IsA("BasePart") and spawnTP or spawnTP:FindFirstChildWhichIsA("BasePart")
            
            if spawnTargetPart then
                local startPos = rootPart.Position
                local targetPos = spawnTargetPart.CFrame.Position + Vector3.new(0, 3, 0)
                local distance = (startPos - targetPos).Magnitude
                local duration = math.clamp(distance / 12, 1.2, 2.5)
                
                local downTween = TweenService:Create(
                    rootPart,
                    TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
                    { CFrame = CFrame.new(targetPos) * CFrame.Angles(0, rootPart.Orientation.Y, 0) }
                )
                
                downTween:Play()
                downTween.Completed:Wait()
            end
        end
    end
    
    autoFarmRunning = false
end

local function startAutoFarm()
    if autoFarmEnabled then return end
    autoFarmEnabled = true
    autoFarmRunning = false
    
    task.spawn(function()
        while autoFarmEnabled do
            doNPCFarmCycle()
            if autoFarmEnabled then
                task.wait(0.5)
            end
        end
    end)
    
    print("✅ Auto NPC Farm Started (Looping)")
    WindUI:Notify({ Title = "Auto Farm Started", Content = "Looping NPC farm is now running!", Duration = 3, Icon = "play" })
end

