-- ========== INVISIBILITY ==========
local invisible = false

local function makeInvisible(char)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.Transparency = 1
        elseif part:IsA("Decal") then
            part.Transparency = 1
        end
    end
end

local function makeVisible(char)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.Transparency = 0
        elseif part:IsA("Decal") then
            part.Transparency = 0
        end
    end
end

MainTab:Toggle({
    Title = "Invisibility",
    Default = false,
    Callback = function(state)
        invisible = state
        local char = player.Character
        if not char then return end
        if state then
            makeInvisible(char)
            WindUI:Notify({ Title = "Invisibility", Content = "You are now invisible!", Duration = 3 })
        else
            makeVisible(char)
            WindUI:Notify({ Title = "Invisibility", Content = "You are now visible!", Duration = 3 })
        end
    end
})

