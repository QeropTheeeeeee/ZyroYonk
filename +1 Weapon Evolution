                    Icon = "arrow-down"
                })
            end
        end
    })

    player.CharacterAdded:Connect(function()
        if flyEnabled then
            task.wait(1)
            startFly()
        end
    end)

    -- Movement Speed Section
    MiscTab:Section({ Title = "Movement Speed" })

    local moveSpeed = 16
    local moveSpeedEnabled = false
    local moveSpeedConn = nil

    MiscTab:Input({
        Title = "Movement Speed",
        Desc = "Set walk speed (default: 16)",
        Placeholder = "Enter speed...",
        Numeric = true,
        Finished = true,
        Callback = function(value)
            local num = tonumber(value)
            if num and num > 0 then
                moveSpeed = num
                if moveSpeedEnabled then
                    local char = player.Character
                    if char then
                        local hum = char:FindFirstChild("Humanoid")
                        if hum then hum.WalkSpeed = moveSpeed end
                    end
                end
                WindUI:Notify({
                    Title = "Move Speed Set",
                    Content = "Speed: " .. tostring(num),
                    Duration = 2,
                    Icon = "zap"
                })
            end
        end
    })

    MiscTab:Toggle({
        Title = "Enable Move Speed",
        Default = false,
        Callback = function(state)
            moveSpeedEnabled = state

            local function applySpeed()
                local char = player.Character
                if char then
                    local hum = char:FindFirstChild("Humanoid")
                    if hum then
                        hum.WalkSpeed = state and moveSpeed or 16
                    end
                end
            end

            applySpeed()

            if state then
                moveSpeedConn = player.CharacterAdded:Connect(function(char)
                    task.wait(1)
                    if moveSpeedEnabled then
                        local hum = char:WaitForChild("Humanoid")
                        hum.WalkSpeed = moveSpeed
                    end
                end)
                WindUI:Notify({
                    Title = "Move Speed ON",
                    Content = "Speed: " .. tostring(moveSpeed),
                    Duration = 3,
                    Icon = "activity"
                })
            else
                if moveSpeedConn then
                    moveSpeedConn:Disconnect()
                    moveSpeedConn = nil
                end
                WindUI:Notify({
                    Title = "Move Speed OFF",
                    Content = "Reset to 16.",
                    Duration = 2,
                    Icon = "minus-circle"
                })
            end
        end
    })

    -- Reset Button
    MiscTab:Section({ Title = "Reset" })
    MiscTab:Button({
        Title = "Reset Position & Health",
        Icon = "refresh-cw",
        Callback = function()
            local char = player.Character
            if not char then
                WindUI:Notify({ Title = "Error", Content = "Character not found.", Duration = 2, Icon = "alert-triangle" })
                return
            end
            local hum = char:FindFirstChild("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root then
                WindUI:Notify({ Title = "Error", Content = "Humanoid or RootPart missing.", Duration = 2, Icon = "alert-triangle" })
                return
            end

            -- Heal
            hum.Health = hum.MaxHealth

            -- Teleport to CommonFloorBest
            local destination = workspace.Break_Map and workspace.Break_Map.Locations and workspace.Break_Map.Locations.CommonFloorBest
            if destination then
                root.CFrame = destination.CFrame + Vector3.new(0, 5, 0)
                WindUI:Notify({ Title = "Reset", Content = "Teleported to Common Floor & fully healed.", Duration = 3, Icon = "check-circle" })
            else
                WindUI:Notify({ Title = "Warning", Content = "CommonFloorBest not found, only healed.", Duration = 3, Icon = "alert-triangle" })
            end
        end
    })

    -- ========== SUPPORT TAB (with Discord) ==========
    local SupportTab = Window:Tab({ Title = "Support", Icon = "heart" })

    local InviteCode = "D5NKtBJEzz"
    local DiscordAPI = "https://discord.com/api/v10/invites/" .. InviteCode .. "?with_counts=true&with_expiration=true"

    local function httpGet(url)
        local body, success = nil, false
        if syn and syn.request then
            success, body = pcall(function() return syn.request({ Url = url, Method = "GET" }).Body end)
        elseif http and http.request then
            success, body = pcall(function() return http.request({ Url = url, Method = "GET" }).Body end)
        elseif request then
            success, body = pcall(function() return request({ Url = url, Method = "GET" }).Body end)
        elseif http_request then
            success, body = pcall(function() return http_request({ Url = url, Method = "GET" }).Body end)
        end
        if success and body then return body else return nil end
    end

    local Response, raw = {}, httpGet(DiscordAPI)
    if raw then pcall(function() Response = HttpService:JSONDecode(raw) end) end

    local onlineCount = Response and Response.approximate_presence_count or "?"
    local totalCount  = Response and Response.approximate_member_count  or "?"
    local guildName   = (Response and Response.guild and Response.guild.name) or "ZyroYonk Hub"
    local iconUrl     = nil
    if Response and Response.guild and Response.guild.id and Response.guild.icon then
        iconUrl = "https://cdn.discordapp.com/icons/"
            .. tostring(Response.guild.id) .. "/"
            .. tostring(Response.guild.icon) .. ".png?size=256"
    end

    SupportTab:Section({ Title = "Discord Server" })

    local cardProps = {
        Title         = guildName,
        Desc          = "Online: " .. tostring(onlineCount) .. "   Members: " .. tostring(totalCount) .. "\n\nJoin for updates & support.",
        Color         = Color3.fromHex("#222222"),
        ImageSize     = 64,
        ThumbnailSize = 100,
        Buttons = {
            {
                Title = "Copy Invite",
                Callback = function()
                    copyToClipboard("https://discord.gg/" .. InviteCode)
                    WindUI:Notify({ Title = "Copied!", Content = "Invite link copied.", Duration = 2, Icon = "clipboard-check" })
                end
            },
            {
                Title = "Join Discord",
                Callback = function()
                    if openUrl then
                        openUrl("https://discord.gg/" .. InviteCode)
                    else
                        copyToClipboard("https://discord.gg/" .. InviteCode)
                        WindUI:Notify({ Title = "Link Copied", Content = "Open in your browser.", Duration = 3, Icon = "globe" })
                    end
                end
            }
        }
    }
    if iconUrl then cardProps.Image = iconUrl end
    SupportTab:Paragraph(cardProps)

    SupportTab:Section({ Title = "Help" })

    SupportTab:Paragraph({
        Title = "Executor",
        Desc  = "Using: " .. executorName .. "\nReport issues in Discord.",
        Color = Color3.fromHex("#222222"),
    })

    SupportTab:Button({
        Title = "Report a Bug",
        Icon  = "bug",
        Callback = function()
            copyToClipboard("Bug Report\nExecutor: " .. executorName .. "\nScript: ZyroYonk Hub v1.0.2\n\nDescribe the issue:")
            WindUI:Notify({ Title = "Template Copied", Content = "Paste in Discord support channel.", Duration = 4, Icon = "message-square" })
        end
    })
end

