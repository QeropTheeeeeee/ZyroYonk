            {text="▲", name="Fwd", pos=UDim2.new(0.5,0,0,5), anchor=Vector2.new(0.5,0)},
            {text="▼", name="Back", pos=UDim2.new(0.5,0,1,-5), anchor=Vector2.new(0.5,1)},
            {text="◀", name="Left", pos=UDim2.new(0,5,0.5,0), anchor=Vector2.new(0,0.5)},
            {text="▶", name="Right", pos=UDim2.new(1,-5,0.5,0), anchor=Vector2.new(1,0.5)},
            {text="⬆", name="Up", pos=UDim2.new(0.5,0,0.3,0), anchor=Vector2.new(0.5,0.5)},
            {text="⬇", name="Down", pos=UDim2.new(0.5,0,0.7,0), anchor=Vector2.new(0.5,0.5)}
        }
        local states = {}
        for _, b in ipairs(btns) do
            local btn = Instance.new("TextButton", frame)
            btn.Size = UDim2.new(0, 45, 0, 45)
            btn.Position = b.pos
            btn.AnchorPoint = b.anchor
            btn.Text = b.text
            btn.TextSize = 20
            btn.TextColor3 = Color3.new(1,1,1)
            btn.BackgroundColor3 = Color3.fromRGB(80,80,80)
            btn.BackgroundTransparency = 0.2
            btn.BorderSizePixel = 0
            btn.AutoButtonColor = false
            states[b.name] = false
            btn.TouchStarted:Connect(function() states[b.name] = true end)
            btn.TouchEnded:Connect(function() states[b.name] = false end)
            btn.MouseButton1Down:Connect(function() states[b.name] = true end)
            btn.MouseButton1Up:Connect(function() states[b.name] = false end)
        end
        mobileFlyGui = gui
        return states
    end

    local function stopFly()
        flyEnabled = false
        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
        local char = player.Character
        if char then
            if char:FindFirstChild("Humanoid") then char.Humanoid.PlatformStand = false end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, obj in pairs(root:GetChildren()) do
                    if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then obj:Destroy() end
                end
            end
        end
        destroyFlyGUI()
    end

    local function startFly()
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        hum.PlatformStand = true
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e9,1e9,1e9)
        bv.Parent = root
        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(1e9,1e9,1e9)
        bg.P = 1e4
        bg.D = 100
        bg.Parent = root

        local mobileStates = nil
        if isMobile then mobileStates = createMobileFlyControls() end

        flyConnection = RunService.Heartbeat:Connect(function()
            if not flyEnabled then return end
            local cam = workspace.CurrentCamera
            local move = Vector3.new(0,0,0)
            if isMobile and mobileStates then
                if mobileStates.Fwd then move = move + cam.CFrame.LookVector end
                if mobileStates.Back then move = move - cam.CFrame.LookVector end
                if mobileStates.Left then move = move - cam.CFrame.RightVector end
                if mobileStates.Right then move = move + cam.CFrame.RightVector end
                if mobileStates.Up then move = move + Vector3.new(0,1,0) end
                if mobileStates.Down then move = move - Vector3.new(0,1,0) end
            else
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0,1,0) end
            end
            if move.Magnitude > 0 then move = move.Unit end
            bv.Velocity = move * flySpeed
            bg.CFrame = cam.CFrame
        end)
    end

