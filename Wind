-- Discord Integration with Glass Effect
do
    local InviteCode = "9X8qygcW"
    local DiscordAPI = "https://discord.com/api/v10/invites/" .. InviteCode .. "?with_counts=true&with_expiration=true"

    -- Send request to Discord API
    local Response = HttpService:JSONDecode(
        WindUI.Creator.Request and WindUI.Creator.Request({
            Url = DiscordAPI,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "WindUI/Example",
                ["Accept"] = "application/json",
            },
        }).Body or "{}"
    )

    -- Add a Discord Tab with Glass Effect
    local DiscordTab = Window:Tab({
        Title = "Discord",
        Border = true,
    })

    -- If response is valid, display Discord info
    if Response and Response.guild then
        DiscordTab:Section({
            Title = "Join our Discord server!",
            TextSize = 20,
        })

        DiscordTab:Paragraph({
            Title = tostring(Response.guild.name),
            Desc = tostring(Response.guild.description),
            Image = "https://cdn.discordapp.com/icons/"
                .. Response.guild.id
                .. "/"
                .. Response.guild.icon
                .. ".png?size=1024",  -- Display server icon
            Thumbnail = "https://cdn.discordapp.com/banners/" .. Response.guild.id .. "/35981388401406a4b7dffd6f447a64c4.png?size=512", -- Banner Image
            ImageSize = 48,
            Buttons = {
                {
                    Title = "Copy link",
                    Icon = "link",
                    Callback = function()
                        setclipboard("https://discord.gg/" .. InviteCode)  -- Copy the invite link
                    end,
                },
            },
        })
    elseif RunService:IsStudio() or not writefile then
        -- Display message for Studio Mode or when API is unavailable
        DiscordTab:Paragraph({
            Title = "Discord API is not available in Studio mode.",
            TextSize = 20,
            Justify = "Center",
            Image = "solar:info-circle-bold",
            Color = "Red",
            Buttons = {
                {
                    Title = "Get/Copy Invite Link",
                    Icon = "link",
                    Callback = function()
                        if setclipboard then
                            setclipboard("https://discord.gg/" .. InviteCode)  -- Copy the invite link in Studio Mode
                        else
                            WindUI:Notify({
                                Title = "Discord Invite Link",
                                Content = "https://discord.gg/" .. InviteCode,
                            })
                        end
                    end,
                },
            },
        })
    else
        -- Display message when fetching Discord info fails
        DiscordTab:Paragraph({
            Title = "Failed to fetch Discord server info.",
            TextSize = 20,
            Justify = "Center",
            Image = "solar:info-circle-bold",
            Color = "Red",
        })
    end
end
