    local function stopFlyMisc()
        flyEnabledMisc = false
        if flyConnectionMisc then flyConnectionMisc:Disconnect(); flyConnectionMisc = nil end
        local char = player.Character
        if char then
            if char:FindFirstChild("Humanoid") then char.Humanoid.PlatformStand = false end
