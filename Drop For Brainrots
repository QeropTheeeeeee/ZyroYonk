local INDEX_IDS = {"Gold", "Luck", "Damage", "RollSpeed"}  -- base index upgrades

-- Returns the Content container inside Canvas
local function getUpgradeContainer()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local main = gui:FindFirstChild("Main")
    if not main then return nil end
    local upgrades = main:FindFirstChild("Upgrades")
    if not upgrades then return nil end
    local canvas = upgrades:FindFirstChild("Canvas")
    if not canvas then return nil end
    local content = canvas:FindFirstChild("Content")
    return content  -- This is exactly the folder with Tile_* objects
end

-- Collects all upgrade IDs from children whose name starts with "Tile_"
local function getAllUpgradeIds(container)
    local ids = {}
    if not container then return ids end
    for _, child in ipairs(container:GetChildren()) do
        local name = child.Name
        if string.sub(name, 1, 5) == "Tile_" then   -- "Tile_" length = 5
            local id = string.sub(name, 6)          -- everything after "Tile_"
            if id and id ~= "" then
                table.insert(ids, id)
            end
        end
    end
    return ids
end
