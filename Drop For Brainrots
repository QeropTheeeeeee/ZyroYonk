-- Function to teleport to the collector part in the selected plot
local function teleportToPodium(plotName)
    local plot = workspace.Plots:WaitForChild(plotName)
    if plot then
        local podiums = plot:FindFirstChild("Podiums")
        if podiums then
            for i = 1, 30 do
                local podium = podiums:FindFirstChild("Podium" .. i)
                if podium then
                    local collectorPart = podium:FindFirstChild("CollectorPart")
                    if collectorPart then
                        game:GetService("Players").LocalPlayer.Character:WaitForChild("HumanoidRootPart").CFrame = collectorPart.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.2) -- Prevent spam teleporting
                    end
                end
            end
        end
    end
end

-- Function to auto collect from the selected plot's podiums
local function autoCollectMoney()
    while autoCollect do
        teleportToPodium(selectedPlot)
        task.wait(1) -- Loop delay (adjust if you want faster collection)
    end
end

-------------------------------------------------
-- FUNCTIONS (Brainrot Farming)
-------------------------------------------------
local function getPart(obj)
    if obj:IsA("BasePart") then
        return obj
    elseif obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    else
        return obj:FindFirstChildWhichIsA("BasePart", true)
    end
end

local function teleportTo(part)
    humanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
end

local function holdE()
    local vim = game:GetService("VirtualInputManager")
    vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.6)
    vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function claimBrainrot()
    game:GetService("ReplicatedStorage")
        :WaitForChild("Remotes")
        :WaitForChild("Gameplay")
        :WaitForChild("CarryUIEvent")
        :FireServer("Claim")
end

local function farmBrainrot()
    while brainrotLoop do
        for _, name in pairs(selectedBrainrots) do
            if not brainrotLoop then break end

            local target = brainrotsFolder:FindFirstChild(name)

            if target then
                local part = getPart(target)
                if part then
                    teleportTo(part)
                    task.wait(1)
                    holdE()
                    claimBrainrot()
                    task.wait(1)
                end
            end
        end
        task.wait(0.5)
    end
end

