-- ================== FALLBACK FUNCTIONS ==================
local function copyToClipboard(text)
    if setclipboard then
        setclipboard(text)
    elseif syn and syn.write_clipboard then
        syn.write_clipboard(text)
    elseif toclipboard then
        toclipboard(text)
    else
        pcall(function()
            local input = Instance.new("TextBox")
            input.Text = text
            input.Parent = game:GetService("CoreGui")
            input:CaptureFocus()
            input:SelectAll()
            input.Parent = nil
        end)
    end
end

-- ================== AUTO COLLECT PLOT BUTTONS 1-8 ==================
local autoCollectButtonsEnabled = false

local function collectPlotButtons()
    if not autoCollectButtonsEnabled then return end
    
    local character = player.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local plotName = player.Name .. " Plot"
    
    local plot = workspace.Plots:FindFirstChild(plotName)
    if not plot then
        plotName = player.DisplayName .. " Plot"
        plot = workspace.Plots:FindFirstChild(plotName)
        if not plot then
            return
        end
    end
    
    local podiumFloorParts = plot:FindFirstChild("PodiumFloorParts")
    if not podiumFloorParts then return end
    
    for i = 1, 8 do
        if not autoCollectButtonsEnabled then break end
        
        local floorPart = podiumFloorParts:FindFirstChild(tostring(i))
        if floorPart then
            local collectButton = floorPart:FindFirstChild("CollectButton")
            if collectButton then
                humanoidRootPart.CFrame = collectButton.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.3)
                pcall(function()
                    if fireclickdetector then
                        fireclickdetector(collectButton)
                    else
                        collectButton:MouseClick()
                    end
                end)
                task.wait(0.2)
            end
        end
    end
end

local function startAutoCollectButtons()
    if autoCollectButtonsEnabled then return end
    autoCollectButtonsEnabled = true
    
    task.spawn(function()
        while autoCollectButtonsEnabled do
            collectPlotButtons()
            if autoCollectButtonsEnabled then
                task.wait(2)
            end
        end
    end)
    
    local plotName = player.Name .. " Plot"
    WindUI:Notify({ 
        Title = "Auto Collect Buttons Started", 
        Content = "Teleporting to buttons 1-8 in: " .. plotName, 
        Duration = 3, 
        Icon = "dollar-sign" 
    })
end

local function stopAutoCollectButtons()
    autoCollectButtonsEnabled = false
    WindUI:Notify({ 
        Title = "Auto Collect Buttons Stopped", 
        Content = "Auto collect has been stopped.", 
        Duration = 3, 
        Icon = "square" 
    })
end

-- ================== AUTO CLAIM TASK ==================
local autoClaimTaskEnabled = false

local function claimTask()
    if not autoClaimTaskEnabled then return end
    
    pcall(function()
        local events = ReplicatedStorage:FindFirstChild("Events")
        if events then
            local possibleEvents = {
                "ClaimTaskEvent",
                "ClaimDailyTaskEvent",
                "CompleteTaskEvent",
                "TaskCompleteEvent",
                "ClaimRewardEvent",
                "DailyRewardEvent",
                "ClaimQuestEvent"
            }
            
            for _, eventName in ipairs(possibleEvents) do
                local event = events:FindFirstChild(eventName)
                if event then
                    event:FireServer()
                    break
                end
            end
        end
        
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            local claimRemote = remotes:FindFirstChild("ClaimTask")
            if claimRemote then
                claimRemote:FireServer()
            end
        end
    end)
end

local function startAutoClaimTask()
    if autoClaimTaskEnabled then return end
    autoClaimTaskEnabled = true
    
    task.spawn(function()
        while autoClaimTaskEnabled do
            claimTask()
            if autoClaimTaskEnabled then
                task.wait(5)
            end
        end
    end)
    
    WindUI:Notify({ 
        Title = "Auto Claim Task Started", 
        Content = "Automatically claiming tasks!", 
        Duration = 3, 
        Icon = "check-circle" 
    })
end

local function stopAutoClaimTask()
    autoClaimTaskEnabled = false
    WindUI:Notify({ 
        Title = "Auto Claim Task Stopped", 
        Content = "Auto claim has been stopped.", 
        Duration = 3, 
        Icon = "square" 
