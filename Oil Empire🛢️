    local function httpGet(url)
        local body = nil
        local success = false
        if syn and syn.request then
            success, body = pcall(function() return syn.request({ Url = url, Method = "GET" }).Body end)
        elseif http and http.request then
            success, body = pcall(function() return http.request({ Url = url, Method = "GET" }).Body end)
        elseif request then
            success, body = pcall(function() return request({ Url = url, Method = "GET" }).Body end)
        elseif http_request then
            success, body = pcall(function() return http_request({ Url = url, Method = "GET" }).Body end)
        end
        if success and body then return body else return nil end
    end
    
    local Response, raw = {}, httpGet(DiscordAPI)
    if raw then pcall(function() Response = HttpService:JSONDecode(raw) end) end
    local onlineCount = Response and Response.approximate_presence_count or "?"
    local totalCount = Response and Response.approximate_member_count or "?"
    local guildName = (Response and Response.guild and Response.guild.name) or "ZyroYonk Hub Discord"
    local iconUrl = nil
    if Response and Response.guild and Response.guild.id and Response.guild.icon then
        iconUrl = "https://cdn.discordapp.com/icons/" .. tostring(Response.guild.id) .. "/" .. tostring(Response.guild.icon) .. ".png?size=256"
    end
    
    SupportTab:Section({ Title = "Join our Discord", Desc = "Get updates, report bugs, and hang out with the community!" })
    
    local cardProps = { 
        Title = guildName, 
        Desc = "🟢 Online: " .. onlineCount .. "   👥 Members: " .. totalCount, 
        ImageSize = 64,
        ThumbnailSize = 100,
        Color = Color3.fromHex("#2C2F33"),
        Buttons = { 
            { 
                Title = "Copy Invite", 
                Callback = function() 
                    copyToClipboard("https://discord.gg/" .. InviteCode)
                    WindUI:Notify({ Title = "Copied!", Content = "Invite link copied to clipboard", Duration = 2, Icon = "clipboard-check" }) 
                end 
            },
            { 
                Title = "Join Discord", 
                Callback = function()
                    if syn and syn.websocket then
                        pcall(function() syn.websocket:connect("discord.gg/" .. InviteCode) end)
                    elseif openUrl then
                        openUrl("https://discord.gg/" .. InviteCode)
                    else
                        copyToClipboard("https://discord.gg/" .. InviteCode)
                        WindUI:Notify({ Title = "Copied!", Content = "Link copied - paste in browser", Duration = 3, Icon = "globe" })
                    end
                end
            }
        } 
    }
    if iconUrl then cardProps.Image = iconUrl end
    SupportTab:Paragraph(cardProps)

    SupportTab:Section({ Title = "Help & Information" })
    SupportTab:Paragraph({
        Title = "📌 Executor Compatibility",
        Desc = "This script is designed to work with most executors. Currently using: **" .. executorName .. "**\n\nIf you encounter issues, please report them in our Discord.",
        Color = Color3.fromHex("#2C2F33"),
        Image = "https://cdn-icons-png.flaticon.com/512/1828/1828665.png",
        ImageSize = 40
    })
    
    SupportTab:Button({
        Title = "Report a Bug",
        Icon = "bug",
        Callback = function()
            copyToClipboard("Bug Report - Executor: " .. executorName .. " - Please describe the issue:")
            WindUI:Notify({ Title = "Template Copied!", Content = "Paste in Discord support channel", Duration = 4, Icon = "message-square" })
        end
    })
end

