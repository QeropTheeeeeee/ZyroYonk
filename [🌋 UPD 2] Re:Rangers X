local AutoDeploy = false
local AutoUpgrade = false
local SpeedGamepass = false
local VoteNext = false
local VoteRetry = false

-- Get all deployable units for the local player
local function GetDeployableUnits()
    local success, collectionFolder = pcall(function()
        return ReplicatedStorage:WaitForChild("Player_Data")
            :WaitForChild(playerName)
            :WaitForChild("Collection")
    end)
    if not success or not collectionFolder then return {} end

    local deployableUnits = {}
    for _, unit in ipairs(collectionFolder:GetChildren()) do
        -- Check if unit has a deployable instance (this usually works for any game)
        if unit:IsA("Folder") or unit:IsA("Model") then
            table.insert(deployableUnits, unit)
        end
    end
    return deployableUnits
end

--------------------------------------------------
-- AUTO DEPLOY
--------------------------------------------------

SpawnTab:Toggle({
    Title = "Auto Deploy All Units",
    Default = false,
    Callback = function(state)
        AutoDeploy = state

        if state then
            task.spawn(function()
                while AutoDeploy do
                    local units = GetDeployableUnits()
                    for _, unit in ipairs(units) do
                        local success, err = pcall(function()
                            ReplicatedStorage:WaitForChild("Remote")
                            :WaitForChild("Server")
                            :WaitForChild("Units")
                            :WaitForChild("Deployment")
                            :FireServer(unit)
                        end)
                        if not success then
                            warn("Failed to deploy unit:", unit.Name, err)
                        end
                    end
                    task.wait(1) -- wait 1 second between loops
                end
            end)
        end
    end
})

