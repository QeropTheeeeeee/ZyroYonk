local function teleportToKickReady()
    local kickPath = workspace.Areas:FindFirstChild("KickReady")
    if not kickPath then return false end
    
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    if kickPath:IsA("BasePart") then
        hrp.CFrame = kickPath.CFrame + Vector3.new(0, 3, 0)
        return true
    else
        local part = kickPath:FindFirstChildWhichIsA("BasePart")
        if part then
            hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
            return true
        end
    end
    return false
end

local function tweenBackToKickReady()
    local kickPath = workspace.Areas:FindFirstChild("KickReady")
    if not kickPath then return end
    
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local targetPart = kickPath:IsA("BasePart") and kickPath or kickPath:FindFirstChildWhichIsA("BasePart")
    if targetPart then
        local targetCF = targetPart.CFrame + Vector3.new(0, 3, 0)
        local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCF})
        tween:Play()
        tween.Completed:Wait()
    end
end

local function startKickLoop()
    if kickRunning then return end
    kickRunning = true
    
    task.spawn(function()
        while kickEnabled and kickRunning do
            -- Step 1: Teleport to KickReady
            local teleported = teleportToKickReady()
            if teleported then
                task.wait(0.3)
                
                -- Step 2: Fire kick event remote
                fireKickEvent()
                
                -- Step 3: Wait for specified seconds (user input)
                local waitTime = math.max(1, kickWaitTime)
                task.wait(waitTime)
                
                -- Step 4: Tween back to KickReady path
                tweenBackToKickReady()
                task.wait(0.3)
            else
                task.wait(1)
            end
        end
        kickRunning = false
    end)
end

local function stopKickLoop()
    kickEnabled = false
    kickRunning = false
    print("✅ Auto Kick Stopped")
    WindUI:Notify({ Title = "Auto Kick Stopped", Content = "Kick loop has been stopped.", Duration = 3, Icon = "square" })
end

local function toggleKick(state)
    if state then
        local kickPath = workspace.Areas:FindFirstChild("KickReady")
        if not kickPath then
            WindUI:Notify({ Title = "Error", Content = "KickReady path not found!", Duration = 3, Icon = "alert-circle" })
            return
        end
        kickEnabled = true
        startKickLoop()
        WindUI:Notify({ Title = "Auto Kick Started", Content = "Teleport → Kick → Wait " .. kickWaitTime .. "s → Tween Back (Looping)", Duration = 4, Icon = "play" })
    else
        stopKickLoop()
    end
end

