-- STEP 1: Teleport to selected CharacterZone
-------------------------------------------------
local function teleportToCharacterZone()
    local ok, zone = pcall(function()
        return workspace.CharacterZones[selectedZone]
    end)
    if ok and zone then
        local root = getRoot()
        if root then
            root.CFrame = zone.CFrame + Vector3.new(0, 5, 0)
            print("[Step 1] ✅ Teleported to CharacterZones[" .. selectedZone .. "]")
            return true
        end
    end
    warn("[Step 1] ❌ CharacterZones[" .. selectedZone .. "] not found!")
    return false
end

-------------------------------------------------
-- STEP 2: Detect closest spawn to player
-------------------------------------------------
local function waitForNormalSpawn()
    local Normal = workspace
        :WaitForChild("Debris", 999)
        :WaitForChild("Server", 999)
        :WaitForChild("Characters", 999)
        :WaitForChild("Normal", 999)

    local result = nil

    local function getClosestPart()
        local root = getRoot()
        if not root then return nil end
        local closest, closestDist = nil, math.huge
        for _, child in ipairs(Normal:GetChildren()) do
            local part = getPartFrom(child)
            if part then
                local dist = (part.Position - root.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = part
                end
            end
        end
        return closest
    end

    result = getClosestPart()

    if not result then
        local connection
        connection = Normal.ChildAdded:Connect(function(child)
            if result then return end
            task.wait(0.15)
            local part = getClosestPart()
            if part then result = part end
        end)
        while autoEnabled and not result do
            task.wait(0.05)
        end
        connection:Disconnect()
    end

    return result
end

-------------------------------------------------
-- STEP 3: Teleport to spawn + Hold E 1 second
-------------------------------------------------
local function holdE(part)
    local root = getRoot()
    if not root or not part then return false end
    root.CFrame = part.CFrame + Vector3.new(0, 4, 0)
    task.wait(0.2)
    if keypress and keyrelease then
        keypress(0x45)
        task.wait(1.0)
        keyrelease(0x45)
        task.wait(0.2)
        return true
    else
        warn("[Step 3] ❌ keypress/keyrelease not supported!")
        return false
    end
end

