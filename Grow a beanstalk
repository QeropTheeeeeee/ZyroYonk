-------------------------------------------------
-- FARM LOOP
-------------------------------------------------
local function startLoop()
    task.spawn(function()
        while autoEnabled do
            local ok = teleportToCharacterZone()
            if not ok then task.wait(1) continue end
            task.wait(0.2)
            local spawnPart = waitForNormalSpawn()
            if not autoEnabled then break end
            local held = false
            if spawnPart then held = holdE(spawnPart) end
            if held then
                task.wait(0.2)
                teleportToMyPlot()
                task.wait(0.5)
            else
                task.wait(0.5)
            end
        end
        print("Farm loop stopped.")
    end)
end

