-- ================== AUTO COLLECT PLOT BUTTONS 1-8 ==================
local autoCollectButtonsEnabled = false

local function collectPlotButtons()
    if not autoCollectButtonsEnabled then return end
    
    local character = player.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local plotName = player.Name .. " Plot"
    
    local plot = workspace.Plots:FindFirstChild(plotName)
    if not plot then
        plotName = player.DisplayName .. " Plot"
        plot = workspace.Plots:FindFirstChild(plotName)
        if not plot then
            return
        end
    end
    
    local podiumFloorParts = plot:FindFirstChild("PodiumFloorParts")
    if not podiumFloorParts then return end
    
    for i = 1, 8 do
        if not autoCollectButtonsEnabled then break end
        
        local floorPart = podiumFloorParts:FindFirstChild(tostring(i))
        if floorPart then
            local collectButton = floorPart:FindFirstChild("CollectButton")
            if collectButton then
                humanoidRootPart.CFrame = collectButton.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.3)
                pcall(function()
                    if fireclickdetector then
                        fireclickdetector(collectButton)
                    else
                        collectButton:MouseClick()
                    end
                end)
                task.wait(0.2)
            end
        end
    end
end

local function startAutoCollectButtons()
    if autoCollectButtonsEnabled then return end
    autoCollectButtonsEnabled = true
    
    task.spawn(function()
        while autoCollectButtonsEnabled do
            collectPlotButtons()
            if autoCollectButtonsEnabled then
                task.wait(2)
            end
        end
    end)
    
    local plotName = player.Name .. " Plot"
