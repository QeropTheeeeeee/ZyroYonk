        Title = "📌 Executor Compatibility",
        Desc = "This script is designed to work with most executors. Currently using: **" .. executorName .. "**\n\nIf you encounter issues, please report them in our Discord.",
        Color = Color3.fromHex("#2C2F33"),
        Image = "https://cdn-icons-png.flaticon.com/512/1828/1828665.png",
        ImageSize = 40
    })
    
    SupportTab:Button({
        Title = "Report a Bug",
        Icon = "bug",
        Callback = function()
            copyToClipboard("Bug Report - Executor: " .. executorName .. " - Please describe the issue:")
            WindUI:Notify({ Title = "Template Copied!", Content = "Paste in Discord support channel", Duration = 4, Icon = "message-square" })
        end
    })
