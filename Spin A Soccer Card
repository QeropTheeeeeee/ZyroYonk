    -- Portable HTTP helper
    local function httpGet(url)
        local body = nil
        if syn and syn.request then
            pcall(function() body = syn.request({ Url = url, Method = "GET" }).Body end)
        elseif http and http.request then
            pcall(function() body = http.request({ Url = url, Method = "GET" }).Body end)
        elseif request then
            pcall(function() body = request({ Url = url, Method = "GET" }).Body end)
        elseif http_request then
            pcall(function() body = http_request({ Url = url, Method = "GET" }).Body end)
        end
        return body
    end

