    MiscTab:Input({ Title = "Walk Speed", Default = "50", Callback = function(v) local n = tonumber(v); if n then walkSpeed = n end end })
    MiscTab:Toggle({ Title = "Speed", Default = false, Callback = function(s) speedEnabled = s; if s then startSpeed() else stopSpeed() end end })

    -- ========== SUPPORT TAB ==========
    local SupportTab = Window:Tab({ Title = "Support", Icon = "house-heart" })
    
    local InviteCode = "D5NKtBJEzz"
    local DiscordAPI = "https://discord.com/api/v10/invites/" .. InviteCode .. "?with_counts=true&with_expiration=true"
    
    local function httpGet(url)
        local body = nil
        local success = false
        if syn and syn.request then
            success, body = pcall(function() return syn.request({ Url = url, Method = "GET" }).Body end)
        elseif http and http.request then
            success, body = pcall(function() return http.request({ Url = url, Method = "GET" }).Body end)
        elseif request then
            success, body = pcall(function() return request({ Url = url, Method = "GET" }).Body end)
        elseif http_request then
            success, body = pcall(function() return http_request({ Url = url, Method = "GET" }).Body end)
        end
        if success and body then return body else return nil end
    end
    
    local Response, raw = {}, httpGet(DiscordAPI)
    if raw then pcall(function() Response = HttpService:JSONDecode(raw) end) end
    local onlineCount = Response and Response.approximate_presence_count or "?"
    local totalCount = Response and Response.approximate_member_count or "?"
    local guildName = (Response and Response.guild and Response.guild.name) or "ZyroYonk Discord"
    local iconUrl = nil
    if Response and Response.guild and Response.guild.id and Response.guild.icon then
        iconUrl = "https://cdn.discordapp.com/icons/" .. tostring(Response.guild.id) .. "/" .. tostring(Response.guild.icon) .. ".png?size=256"
    end
    
    SupportTab:Section({ Title = "Join our Discord", Desc = "Get updates, report bugs, and hang out with the community!" })
    
    local cardProps = { 
        Title = guildName, 
        Desc = "🟢 Online: " .. onlineCount .. "   👥 Members: " .. totalCount, 
