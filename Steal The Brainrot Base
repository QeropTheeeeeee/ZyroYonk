-------------------------------------------------
-- HOLD E FUNCTION
-------------------------------------------------
local function holdE()
    vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.1)
    vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-------------------------------------------------
-- GET PLAYER PLOT
-------------------------------------------------
local function getMyPlot()
    local closest, dist = nil, math.huge
    for _, obj in pairs(workspace:GetChildren()) do
        if obj.Name:match("^Plot_") and obj:FindFirstChild("Spawn") then
            local d = (hrp.Position - obj.Spawn.Position).Magnitude
            if d < dist then
                dist = d
                closest = obj
            end
        end
    end
    return closest
end

local function teleportPlot()
    local plot = getMyPlot()
    if plot then
        hrp.CFrame = plot.Spawn.CFrame + Vector3.new(0,3,0)
    end
end

-------------------------------------------------
-- AUTO FARM LOOP (SLOT1 → SLOT10)
-------------------------------------------------
local function teleportAllSlots()
    local base = difficultyMap[selectedDifficulty]
    if not base then return end

    local slots = base:FindFirstChild("Slots")
    if not slots then return end

    for i = 1, 10 do
        if not autoFarmRunning then break end

        local slot = slots:FindFirstChild("Slot"..i)
        if slot and slot:FindFirstChild("Stand") then
            local target = slot.Stand:GetChildren()[2]
            if target then
                hrp.CFrame = target.CFrame + Vector3.new(0,3,0)
                task.wait(0.3)
                holdE()
                task.wait(0.2)
                teleportPlot()
                task.wait(0.5)
            end
        end
    end
end

local function autoFarmLoop()
    while autoFarmRunning do
        teleportAllSlots()
        task.wait(0.3)
    end
end

-------------------------------------------------
-- AUTO UPGRADE LOOP
-------------------------------------------------
local function autoUpgradeLoop()
    while autoUpgradeRunning do
        for i = 1, 10 do
            game.ReplicatedStorage.Events.RequestFloorPurchase:FireServer("Floor"..i)
            task.wait(0.5)
        end
        task.wait(1)
    end
end

-------------------------------------------------
-- AUTO BASE LOOP
-------------------------------------------------
local function autoBaseLoop()
    while autoBaseRunning do
        for i = 2, 10 do
            game.ReplicatedStorage.Events.RequestBasePurchase:FireServer("Base"..i)
            task.wait(0.5)
        end
        task.wait(1)
    end
end

