-- DIFFICULTY MAP
-------------------------------------------------
local difficultyMap = {
    ["Easy"] = workspace.Bases.Base1,
    ["Normal"] = workspace.Bases.Base2,
    ["Medium"] = workspace.Bases.Base3,
    ["Hard"] = workspace.Bases.Base4,
    ["Extreme"] = workspace.Bases.Base5,
    ["Insane"] = workspace.Bases.Base6,
    ["Nightmare"] = workspace.Bases.Base7,
