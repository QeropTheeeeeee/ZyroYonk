local function executeForCorrectGame(scripts)
    local currentGameId = tostring(game.PlaceId)
    
    if scripts[currentGameId] then
        -- Execute the script for this game ID
        loadstring(game:HttpGet(scripts[currentGameId]))()
        print("Script executed for game ID: " .. currentGameId)
    else
        print("No script found for game ID: " .. currentGameId)
    end
end

