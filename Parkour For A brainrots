    -- Teleport to spawn
    local function teleportToSpawn()
        print("[INFO] Teleporting back to SpawnLocation...")
        rootPart.CFrame = CFrame.new(SpawnLocation.Position + Vector3.new(0, 3, 0))
        print("[INFO] Back at SpawnLocation!")
    end

    -- Wait for zone children to spawn
    local function waitForSpawn(Zone)
        print("[INFO] Waiting for " .. Zone.Name .. " parts to spawn...")
        while true do
            if #Zone:GetChildren() > 0 then
                print("[INFO] " .. Zone.Name .. " spawned! Children:")
                for i, v in ipairs(Zone:GetChildren()) do
                    print("  [" .. i .. "]", v.ClassName, v.Name)
                end
                break
            end
            task.wait(0.1)
        end
    end

    -- Get center of zone
    local function getCenter(Zone)
        local total = Vector3.new(0, 0, 0)
        local count = 0
        for _, child in ipairs(Zone:GetChildren()) do
            if child:IsA("BasePart") then
                total = total + child.Position
                count = count + 1
            elseif child:IsA("Model") then
                local cf, _ = child:GetBoundingBox()
                total = total + cf.Position
                count = count + 1
            end
        end
        if count == 0 then return nil end
        return total / count
    end

    -- Teleport to part
    local function teleportToPart(part)
        if part:IsA("BasePart") then
            rootPart.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
        elseif part:IsA("Model") then
            local cf, _ = part:GetBoundingBox()
            rootPart.CFrame = CFrame.new(cf.Position + Vector3.new(0, 3, 0))
        end
    end

    -- Hold E
    local function holdE()
        print("[INFO] Holding E for 0.5 seconds...")
        if syn then
            syn.key_press(Enum.KeyCode.E)
            task.wait(0.5)
            syn.key_release(Enum.KeyCode.E)
        elseif keypress then
            keypress(0x45)
            task.wait(0.5)
            keyrelease(0x45)
        else
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.5)
            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
        print("[INFO] Done holding E!")
    end

    -- Detect and interact
    local function detectAndInteract(Zone)
        local children = Zone:GetChildren()
        print("[INFO] Scanning " .. #children .. " parts in " .. Zone.Name .. "...")

        for _, child in ipairs(children) do
            print("[SCANNING]", child.ClassName, child.Name)

            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("ProximityPrompt") then
                    print("[FOUND] ProximityPrompt ->", desc:GetFullName())
                    teleportToPart(child)
                    task.wait(0.3)
                    fireproximityprompt(desc)
                    task.wait(0.5)
                    print("[FIRED] ProximityPrompt!")
                    teleportToSpawn()
                    return
                end
            end

            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("ClickDetector") then
                    print("[FOUND] ClickDetector ->", desc:GetFullName())
                    teleportToPart(child)
                    task.wait(0.3)
                    fireclickdetector(desc)
                    task.wait(0.5)
                    print("[FIRED] ClickDetector!")
                    teleportToSpawn()
                    return
                end
            end

            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("RemoteEvent") then
                    print("[FOUND] RemoteEvent ->", desc:GetFullName())
                    teleportToPart(child)
                    task.wait(0.3)
                    desc:FireServer()
                    task.wait(0.5)
                    print("[FIRED] RemoteEvent!")
                    teleportToSpawn()
                    return
                end
            end

            if child:IsA("BasePart") then
                print("[FOUND] BasePart ->", child.Name)
                teleportToPart(child)
                task.wait(0.3)
                firetouchinterest(rootPart, child, 0)
                task.wait(0.5)
                firetouchinterest(rootPart, child, 1)
                print("[FIRED] Touch on", child.Name)
                teleportToSpawn()
                return
            end

            if child:IsA("Model") then
                local part = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                if part then
                    print("[FOUND] Model ->", child.Name, "Part ->", part.Name)
                    teleportToPart(child)
                    task.wait(0.3)
                    firetouchinterest(rootPart, part, 0)
                    task.wait(0.5)
                    firetouchinterest(rootPart, part, 1)
                    print("[FIRED] Touch on", child.Name)
                    teleportToSpawn()
                    return
                end
            end
        end

        print("[FALLBACK] No interact found, holding E...")
        holdE()
        teleportToSpawn()
    end

    -- Farm loop
    local function farmLoop()
        while farmingActive do
            if not selectedZone then
                task.wait(1)
                continue
            end

            local Zone = Brainrots:FindFirstChild(selectedZone)
            if not Zone then
                print("[WARN] Zone not found:", selectedZone)
                task.wait(1)
                continue
            end

            Zone.ChildAdded:Connect(function(child)
                print("[LIVE SPAWN]", child.ClassName, child.Name)
            end)

            waitForSpawn(Zone)

            local center = getCenter(Zone)
            if not center then
                print("[WARN] No center found for", selectedZone)
                continue
            end

            print("[INFO] Teleporting to", selectedZone, "center:", center)
            rootPart.CFrame = CFrame.new(center + Vector3.new(0, 3, 0))
            task.wait(0.4)

            detectAndInteract(Zone)
            print("[DONE]", selectedZone, "finished! Looping...")
            task.wait(0.3)
        end
    end

    -- Mapping
    local rarityToZone = {
